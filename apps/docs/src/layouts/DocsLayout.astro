---
import MainLayout from './MainLayout.astro';
import { getLangFromUrl } from '../utils/i18n';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const basePrefix = lang === 'en' ? '/en' : '/id';
const currentPath = Astro.url.pathname.replace(/\/$/, '');

const sections = lang === 'id'
  ? [
      { label: 'Mulai', items: [
        { href: `${basePrefix}/docs`, label: 'Ringkasan' },
        { href: `${basePrefix}/docs/getting-started`, label: 'Memulai' },
      ] },
      { label: 'Referensi', items: [
        { href: `${basePrefix}/docs/architecture`, label: 'Arsitektur' },
        { href: `${basePrefix}/docs/api`, label: 'Referensi API' },
        { href: `${basePrefix}/docs/configuration`, label: 'Konfigurasi' },
        { href: `${basePrefix}/docs/api-key-rotation`, label: 'Rotasi API key' },
      ] },
      { label: 'Operasional', items: [
        { href: `${basePrefix}/docs/deployment`, label: 'Deployment' },
        { href: `${basePrefix}/docs/operations`, label: 'Operasional & Troubleshooting' },
      ] },
      { label: 'Open Source', items: [
        { href: `${basePrefix}/docs/development`, label: 'Development' },
        { href: `${basePrefix}/docs/project`, label: 'Project & Community' },
      ] },
    ]
  : [
      { label: 'Start', items: [
        { href: `${basePrefix}/docs`, label: 'Overview' },
        { href: `${basePrefix}/docs/getting-started`, label: 'Getting Started' },
      ] },
      { label: 'Reference', items: [
        { href: `${basePrefix}/docs/architecture`, label: 'Architecture' },
        { href: `${basePrefix}/docs/api`, label: 'API Reference' },
        { href: `${basePrefix}/docs/configuration`, label: 'Configuration' },
        { href: `${basePrefix}/docs/api-key-rotation`, label: 'API key rotation' },
      ] },
      { label: 'Operate', items: [
        { href: `${basePrefix}/docs/deployment`, label: 'Deployment' },
        { href: `${basePrefix}/docs/operations`, label: 'Operations & Troubleshooting' },
      ] },
      { label: 'Open Source', items: [
        { href: `${basePrefix}/docs/development`, label: 'Development' },
        { href: `${basePrefix}/docs/project`, label: 'Project & Community' },
      ] },
    ];

function isActive(href: string) {
  return currentPath === href.replace(/\/$/, '');
}
---

<MainLayout title={`${title} — Wago`} description={description}>
  <div class="docs-shell py-7 lg:py-10">
    <details class="mb-8 border-y border-[var(--docs-line)] lg:hidden">
      <summary class="cursor-pointer py-3 text-[13px] font-medium text-[var(--docs-text)]">
        {lang === 'id' ? 'Navigasi dokumentasi' : 'Documentation navigation'}
      </summary>
      <div class="grid gap-5 border-t border-[var(--docs-line)] py-4 sm:grid-cols-2">
        {sections.map(section => (
          <section>
            <p class="mb-2 mt-0 font-mono text-[10px] font-medium uppercase tracking-[0.06em] text-[var(--docs-tertiary)]">{section.label}</p>
            <nav class="border-l border-[var(--docs-line)]">
              {section.items.map(item => (
                <a href={item.href} class="docs-nav-link" aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              ))}
            </nav>
          </section>
        ))}
      </div>
    </details>

    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[220px_minmax(0,1fr)] lg:gap-12 xl:gap-16">
      <aside class="hidden lg:block">
        <nav class="sticky top-20 space-y-6" aria-label={lang === 'id' ? 'Navigasi dokumentasi' : 'Documentation navigation'}>
          {sections.map(section => (
            <section>
              <p class="mb-2 mt-0 px-3 font-mono text-[10px] font-medium uppercase tracking-[0.06em] text-[var(--docs-tertiary)]">{section.label}</p>
              <div class="border-l border-[var(--docs-line)]">
                {section.items.map(item => (
                  <a href={item.href} class="docs-nav-link" aria-current={isActive(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                ))}
              </div>
            </section>
          ))}
        </nav>
      </aside>

      <article class="docs-article">
        <slot />
      </article>
    </div>
  </div>
</MainLayout>
