---
import DocsLayout from '../../layouts/DocsLayout.astro';
import PageHeader from './PageHeader.astro';
import Callout from './Callout.astro';
import CodeBlock from './CodeBlock.astro';

interface Props { lang: 'en' | 'id' }
const { lang } = Astro.props;
const id = lang === 'id';
---

<DocsLayout title="Development">
  <PageHeader
    eyebrow="Contributors"
    title="Development workflow"
    description={id ? 'Workflow lokal untuk core backend/frontend, public Astro docs, dan batas yang jelas untuk artefak kerja agent.' : 'Local workflow for the backend/frontend core, public Astro docs, and the explicit boundary for agent work artifacts.'}
  />

  <h2 class="text-xl font-semibold text-[#fafafa] mb-3">Toolchain</h2>
  <ul class="list-disc pl-5 text-sm text-[#a1a1aa] space-y-2 mb-8">
    <li>Node.js 26</li>
    <li>pnpm 11.21.0</li>
    <li>Backend: TypeScript, Express, Baileys, SQLite, Vitest</li>
    <li>Frontend: React, Vite, Tailwind CSS, Vitest</li>
    <li>Docs: Astro + React islands + Tailwind CSS + Node test runner</li>
    <li>Biome</li>
  </ul>

  <Callout title={id ? 'docs/ adalah dokumentasi publik' : 'docs/ is public documentation'} tone="warning">
    {id ? 'Jangan simpan implementation plan, scratchpad, checkpoint internal, atau instruksi agent di docs/. Gunakan .agent/specs/, .agent/plans/, atau .agent/checkpoints/. Public Astro docs tetap dapat dibaca user tanpa noise proses internal.' : 'Do not store implementation plans, scratchpads, internal checkpoints, or agent instructions under docs/. Use .agent/specs/, .agent/plans/, or .agent/checkpoints/. The public Astro docs should stay readable without internal process noise.'}
  </Callout>

  <h2 class="text-xl font-semibold text-[#fafafa] mt-9 mb-3">{id ? 'Struktur repo' : 'Repository layout'}</h2>
  <CodeBlock label="tree" code={`backend/        Express API, policy, SQLite, Baileys integration, tests\nfrontend/       Gateway control and audit workspaces\ndocs/           Public Astro documentation site\n.agent/         Internal agent specs, plans, and checkpoints\n.github/        CI, Docs CI, CodeQL, release, issue/PR templates\nDockerfile      Production core image\ndocker-compose.yml\nplan.md         Concise engineering roadmap\nREADME.md\nCONTRIBUTING.md\nSECURITY.md\nCODE_OF_CONDUCT.md\nCHANGELOG.md\nLICENSE`} />

  <Callout title={id ? 'Docs bukan runtime artifact' : 'Docs are not a runtime artifact'}>
    {id ? 'Production Docker/GHCR hanya membawa backend + frontend core. Astro docs dibangun dan di-host sebagai artifact publik terpisah.' : 'Production Docker/GHCR contains only the backend + frontend core. Astro docs are built and hosted as a separate public artifact.'}
  </Callout>

  <h2 class="text-xl font-semibold text-[#fafafa] mt-9 mb-3">{id ? 'Install dan quality gates core' : 'Install and core quality gates'}</h2>
  <CodeBlock label="shell" code={`pnpm install\npnpm check\npnpm test\npnpm build`} />
  <p class="text-sm text-[#a1a1aa] mb-8">{id ? 'pnpm build membangun backend dan frontend saja. Ini adalah boundary distributable core.' : 'pnpm build builds backend and frontend only. This is the distributable core boundary.'}</p>

  <h2 class="text-xl font-semibold text-[#fafafa] mb-3">{id ? 'Validasi public docs' : 'Validate public docs'}</h2>
  <CodeBlock label="shell" code={`pnpm --dir docs test\npnpm build:docs\npnpm --dir docs dev`} />
  <p class="text-sm text-[#71717a] mb-8">{id ? 'Docs tests memverifikasi endpoint catalog/request builder/response formatter. Astro build memverifikasi integrasi page dan React island.' : 'Docs tests verify the endpoint catalog, request builder, and response formatter. The Astro build verifies page and React-island integration.'}</p>

  <h2 class="text-xl font-semibold text-[#fafafa] mb-3">{id ? 'Menjalankan core' : 'Running the core locally'}</h2>
  <CodeBlock label="terminals" code={`pnpm --dir backend dev\npnpm --dir frontend dev`} />
  <p class="text-sm text-[#a1a1aa] mb-8">{id ? 'Jika frontend memakai backend non-default, set VITE_API_BASE_URL sebelum dev/build frontend.' : 'If the frontend targets a non-default backend origin, set VITE_API_BASE_URL before frontend dev/build.'}</p>

  <h2 class="text-xl font-semibold text-[#fafafa] mb-3">{id ? 'Targeted commands' : 'Targeted commands'}</h2>
  <CodeBlock label="shell" code={`pnpm --dir backend test\npnpm --dir frontend test\npnpm --dir docs test\npnpm --dir backend build\npnpm --dir frontend build\npnpm build:docs\npnpm check:fix`} />

  <h2 class="text-xl font-semibold text-[#fafafa] mt-9 mb-3">Testing philosophy</h2>
  <p class="text-sm text-[#a1a1aa] leading-relaxed mb-4">{id ? 'Test behavior Wago, bukan internals Baileys. Fokus pada wrapper, policy decisions, validation, routes, cache/store, lifecycle behavior, dan kontrak dokumentasi yang dapat drift dari source code.' : 'Test Wago behavior rather than Baileys internals. Focus on wrappers, policy decisions, validation, routes, caches/stores, lifecycle behavior, and documentation contracts that can drift from source code.'}</p>
  <Callout title={id ? 'Perubahan kontrak wajib diuji' : 'Contract changes require tests'} tone="warning">
    {id ? 'Perubahan consent, rate limits, idempotency, auth, phone normalization, reconnect, atau public route harus membawa regression test yang relevan. Jika API berubah, endpoint catalog dan public docs harus ikut diperbarui.' : 'Changes to consent, rate limits, idempotency, auth, phone normalization, reconnect behavior, or public routes should include relevant regression tests. When the API changes, update the endpoint catalog and public docs in the same change.'}
  </Callout>

  <h2 class="text-xl font-semibold text-[#fafafa] mt-9 mb-3">Pull requests</h2>
  <ul class="list-disc pl-5 text-sm text-[#a1a1aa] space-y-2">
    <li>{id ? 'Jelaskan behavior yang berubah dan alasan.' : 'Describe the changed behavior and why.'}</li>
    <li>{id ? 'Tambahkan/ubah test atau jelaskan mengapa tidak relevan.' : 'Add/update tests or explain why they are not applicable.'}</li>
    <li>{id ? 'Cantumkan verification commands dan hasil yang relevan.' : 'List relevant verification commands and results.'}</li>
    <li>{id ? 'Sertakan screenshot untuk perubahan UI bila relevan.' : 'Include screenshots for relevant UI changes.'}</li>
    <li>{id ? 'Jangan lampirkan QR live, auth files, API key, full number/JID, message text, database/backup, atau production logs mentah.' : 'Never attach live QR codes, auth files, API keys, full phone/JIDs, message text, databases/backups, or raw production logs.'}</li>
  </ul>
</DocsLayout>
