---
import DocsLayout from '../../layouts/DocsLayout.astro';
import PageHeader from './PageHeader.astro';
import Callout from './Callout.astro';
import PlantUmlDiagram from './PlantUmlDiagram.astro';

interface Props { lang: 'en' | 'id' }
const { lang } = Astro.props;
const id = lang === 'id';
---

<DocsLayout title={id ? 'Arsitektur' : 'Architecture'}>
  <PageHeader eyebrow="Internals" title={id ? 'Arsitektur aplikasi' : 'Application architecture'} description={id ? 'Satu proses Node.js menyajikan API dan dashboard React, memakai SQLite untuk state durable, dan memelihara satu koneksi Baileys.' : 'One Node.js process serves the API and React dashboard, uses SQLite for durable state, and maintains one Baileys connection.'} />

  <PlantUmlDiagram file="system-architecture.puml" alt="Wago runtime architecture" caption={id ? 'Arsitektur runtime production Wago.' : 'Wago production runtime architecture.'} />

  <h2 class="text-xl font-semibold text-[#fafafa] mb-4">Backend</h2>
  <div class="overflow-x-auto mb-9"><table class="w-full text-sm"><tbody class="divide-y divide-[#1a1a1a]">
    <tr><td class="py-3 pr-5 text-[#fafafa] font-medium">app/</td><td class="py-3 text-[#a1a1aa]">{id ? 'Composition dan lifecycle yang melintasi beberapa capability.' : 'Composition and lifecycle coordination that spans capabilities.'}</td></tr>
    <tr><td class="py-3 pr-5 text-[#fafafa] font-medium">modules/</td><td class="py-3 text-[#a1a1aa]">{id ? 'Owner capability: access, activity, gateway, messages, metrics, recipients, webhooks, dan whatsapp.' : 'Capability owners: access, activity, gateway, messages, metrics, recipients, webhooks, and whatsapp.'}</td></tr>
    <tr><td class="py-3 pr-5 text-[#fafafa] font-medium">infrastructure/</td><td class="py-3 text-[#a1a1aa]">{id ? 'SQLite setup/migration, runtime persistence mechanism, lease/mount safety, dan logging.' : 'SQLite setup/migrations, runtime persistence mechanisms, lease/mount safety, and logging.'}</td></tr>
    <tr><td class="py-3 pr-5 text-[#fafafa] font-medium">http/</td><td class="py-3 text-[#a1a1aa]">{id ? 'Transport HTTP reusable: middleware, auth attachment, request handling, dan response/error mapping.' : 'Reusable HTTP transport: middleware, auth attachment, request handling, and response/error mapping.'}</td></tr>
    <tr><td class="py-3 pr-5 text-[#fafafa] font-medium">config/</td><td class="py-3 text-[#a1a1aa]">{id ? 'Environment, runtime paths, App ID, dan validasi production.' : 'Environment, runtime paths, App ID, and production validation.'}</td></tr>
    <tr><td class="py-3 pr-5 text-[#fafafa] font-medium">errors/</td><td class="py-3 text-[#a1a1aa]">{id ? 'Primitive error yang benar-benar cross-cutting.' : 'Genuinely cross-cutting error primitives.'}</td></tr>
    <tr><td class="py-3 pr-5 text-[#fafafa] font-medium">architecture/</td><td class="py-3 text-[#a1a1aa]">{id ? 'Regression test untuk dependency boundary yang masih aktif.' : 'Regression tests for currently meaningful dependency boundaries.'}</td></tr>
  </tbody></table></div>

  <h2 class="text-xl font-semibold text-[#fafafa] mb-4">Frontend</h2>
  <p class="text-sm text-[#a1a1aa] leading-relaxed mb-5">{id ? 'React memakai relative API base pada production sehingga Express menyajikan UI dan API dari origin yang sama. API key hanya berada sementara di memory saat bootstrap atau sign-in. Dashboard tidak menyimpan API key di sessionStorage/localStorage; backend menukar credential operator menjadi opaque HttpOnly browser session yang hash tokennya disimpan di SQLite.' : 'React uses a relative API base in production so Express serves UI and API from the same origin. The API key exists only temporarily in memory during bootstrap or sign-in. The dashboard does not store the API key in sessionStorage/localStorage; the backend exchanges operator credentials for an opaque HttpOnly browser session whose token hash is stored in SQLite.'}</p>
  <ul class="list-disc pl-5 text-sm text-[#a1a1aa] space-y-2 mb-9">
    <li>{id ? 'Control berfokus pada readiness gateway, koneksi/pairing WhatsApp, health, dan diagnostics ringkas.' : 'Control focuses on gateway readiness, WhatsApp connection/pairing, health, and compact diagnostics.'}</li>
    <li>{id ? 'Settings memiliki API credential, recipient policy, webhook configuration/delivery diagnostics, dan browser-session administration.' : 'Settings owns API credentials, recipient policy, webhook configuration/delivery diagnostics, and browser-session administration.'}</li>
    <li>{id ? 'Audit Log memiliki operational evidence, filtering/search, dan technical detail untuk investigasi.' : 'Audit Log owns operational evidence, filtering/search, and technical detail for investigation.'}</li>
    <li>{id ? 'Public Astro docs merupakan artifact terpisah dan tidak dibundle ke runtime production Wago.' : 'The public Astro docs are a separate artifact and are not bundled into the Wago production runtime.'}</li>
  </ul>

  <Callout title={id ? 'Audit bukan raw protocol capture' : 'Audit is not raw protocol capture'}>{id ? 'Lifecycle Baileys direkam sebagai event terstruktur. Adapter audit hanya mempertahankan primitive metadata yang diizinkan, masking identifier, dan membuang QR, message body, credential/key material, token, cookie, serta nested/raw protocol payload.' : 'Baileys lifecycle evidence is recorded as structured events. The audit adapter keeps only allowed primitive metadata, masks identifiers, and drops QR values, message bodies, credential/key material, tokens, cookies, and nested/raw protocol payloads.'}</Callout>

  <h2 class="text-xl font-semibold text-[#fafafa] mt-9 mb-4">{id ? 'Flow bootstrap dan pairing' : 'Bootstrap and pairing flow'}</h2>
  <PlantUmlDiagram file="bootstrap-pairing-flow.puml" alt="Wago first-run credential bootstrap and WhatsApp pairing flow" caption={id ? 'API-key hash, browser-session hash, dan account binding berada di SQLite; Baileys auth tetap berada di /app/data/auth.' : 'The API-key hash, browser-session hash, and account binding live in SQLite; Baileys auth remains under /app/data/auth.'} />

  <h2 class="text-xl font-semibold text-[#fafafa] mb-4">{id ? 'Flow outbound message' : 'Outbound message flow'}</h2>
  <PlantUmlDiagram file="outbound-message-flow.puml" alt="Wago protected outbound text-message flow" caption={id ? 'Policy Wago dievaluasi sebelum outbound text diteruskan ke Baileys.' : 'Wago policy is evaluated before outbound text is passed to Baileys.'} />

  <h2 class="text-xl font-semibold text-[#fafafa] mb-4">{id ? 'Persistent vs transient state' : 'Persistent vs transient state'}</h2>
  <div class="grid sm:grid-cols-2 gap-4 mb-8"><div class="border border-[#262626] rounded-lg p-5"><h3 class="font-semibold text-sm text-[#fafafa] mb-2">Persistent</h3><ul class="text-sm text-[#71717a] space-y-1.5"><li><code>/app/data/wago.db</code> — settings, API-key hash, browser sessions, binding, recipients, outbound diagnostics/policy, webhook state, audit events</li><li><code>/app/data/auth/</code> — {id ? 'credential/session Baileys' : 'Baileys credentials/session'}</li></ul></div><div class="border border-[#262626] rounded-lg p-5"><h3 class="font-semibold text-sm text-[#fafafa] mb-2">Transient</h3><ul class="text-sm text-[#71717a] space-y-1.5"><li>{id ? 'raw credential hanya selama flow yang memang perlu menampilkannya' : 'raw credentials only during flows that explicitly need to display them'}</li><li>{id ? 'QR dan connection/reconnect snapshot' : 'QR and connection/reconnect snapshots'}</li><li>{id ? 'account-health cache dan state runtime lain yang tidak perlu durable' : 'account-health cache and other runtime state that does not need durability'}</li></ul></div></div>

  <h2 class="text-xl font-semibold text-[#fafafa] mb-3">SQLite</h2>
  <p class="text-sm text-[#a1a1aa] leading-relaxed mb-5">{id ? 'Wago menggunakan node:sqlite bawaan Node.js tanpa ORM atau database service tambahan. Database memakai WAL, migration table, prepared statements, busy timeout, dan index untuk query operasional. API key dan browser-session token hanya disimpan dalam bentuk hash.' : 'Wago uses Node.js built-in node:sqlite without an ORM or separate database service. The database uses WAL, a migration table, prepared statements, a busy timeout, and indexes for operational queries. API keys and browser-session tokens are stored only as hashes.'}</p>
  <Callout title={id ? 'Satu source of truth' : 'One source of truth'}>{id ? 'SQLite adalah authoritative application store. Baileys auth tetap filesystem-backed di /app/data/auth karena lifecycle credential-nya dimiliki oleh boundary WhatsApp.' : 'SQLite is the authoritative application store. Baileys auth remains filesystem-backed under /app/data/auth because its credential lifecycle belongs to the WhatsApp boundary.'}</Callout>
  <Callout title={id ? 'Skalabilitas sengaja dibatasi' : 'Scaling is intentionally constrained'} tone="warning">{id ? 'Jangan jalankan beberapa replica terhadap /app/data yang sama. Model ini single-process/single-account dan tidak dirancang untuk horizontal scaling atau distributed rate limiting.' : 'Do not run multiple replicas against the same /app/data volume. This is a single-process/single-account model and is not designed for horizontal scaling or distributed rate limiting.'}</Callout>
</DocsLayout>
