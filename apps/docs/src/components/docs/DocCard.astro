---
interface Props {
  href: string;
  title: string;
  description: string;
}

const { href, title, description } = Astro.props;
---

<a href={href} class="docs-list-link group">
  <span>
    <span class="docs-list-link-title group-hover:text-[var(--docs-accent-strong)]">{title}</span>
    <span class="docs-list-link-description block">{description}</span>
  </span>
  <span class="docs-list-link-arrow" aria-hidden="true">→</span>
</a>
