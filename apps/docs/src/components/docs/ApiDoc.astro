---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { ApiExplorer } from '../api/ApiExplorer';
import { apiEndpoints } from '../api/endpoint-catalog';
import PageHeader from './PageHeader.astro';
import Callout from './Callout.astro';
import CodeBlock from './CodeBlock.astro';

interface Props { lang: 'en' | 'id' }
const { lang } = Astro.props;
const id = lang === 'id';

const authName = (auth: string) => {
  if (auth === 'public') return id ? 'Publik' : 'Public';
  if (auth === 'first-run') return 'First run';
  return 'Bearer API key';
};
---

<DocsLayout
  title={id ? 'Referensi API' : 'API Reference'}
  description={id
    ? 'Referensi HTTP Wago, alur integrasi eksternal, error model, dan Hybrid API Explorer.'
    : 'Wago HTTP reference, external integration flow, error model, and Hybrid API Explorer.'}
>
  <PageHeader
    eyebrow="HTTP API"
    title={id ? 'Integrasikan Wago tanpa membaca source code' : 'Integrate Wago without reading the source code'}
    description={id
      ? 'Gunakan Bearer API key dari backend aplikasi Anda, izinkan recipient saat permission diperoleh, kirim text dengan idempotency key, lalu baca status atau audit event.'
      : 'Use a Bearer API key from your application backend, allow recipients when permission is obtained, send text with an idempotency key, then inspect message status or audit events.'}
  />

  <Callout title={id ? 'Gunakan server-to-server untuk aplikasi eksternal' : 'Use server-to-server integration for external apps'} tone="warning">
    {id
      ? 'Jangan menaruh WAGO_API_KEY di React/Vue/browser application Anda. Simpan secret di backend aplikasi, lalu backend tersebut memanggil Wago.'
      : 'Do not embed WAGO_API_KEY in a React/Vue/browser application. Keep the secret in your application backend and let that backend call Wago.'}
  </Callout>

  <CodeBlock label={id ? 'Pola integrasi' : 'Integration pattern'} code={`Browser / mobile client\n        |\n        v\nApplication backend\n        |\n        | Authorization: Bearer <WAGO_API_KEY>\n        v\n       Wago\n        |\n        v\n    WhatsApp`} />

  <h2 class="text-xl font-semibold text-[#fafafa] mt-10 mb-3">{id ? 'Autentikasi' : 'Authentication'}</h2>
  <p class="text-sm text-[#a1a1aa] leading-relaxed mb-4">{id ? 'Semua endpoint terproteksi menerima Bearer header. Dashboard Wago juga dapat memakai HttpOnly cookie hasil bootstrap, tetapi external application sebaiknya menggunakan API key dari backend/server.' : 'All protected endpoints accept a Bearer header. The Wago dashboard can also use the HttpOnly cookie created during bootstrap, but external applications should use an API key from a backend/server.'}</p>
  <CodeBlock label="HTTP" code={`Authorization: Bearer <API_KEY>`} />

  <div class="grid sm:grid-cols-3 gap-4 mt-6 mb-10">
    <div class="border border-[#262626] rounded-lg p-5"><p class="text-xs uppercase tracking-wider text-[#52525b]">Public</p><p class="text-sm text-[#a1a1aa] mt-2">{id ? 'Health, readiness, dan setup info dasar.' : 'Health, readiness, and basic setup info.'}</p></div>
    <div class="border border-[#262626] rounded-lg p-5"><p class="text-xs uppercase tracking-wider text-[#52525b]">First run</p><p class="text-sm text-[#a1a1aa] mt-2">{id ? 'Bootstrap credential dengan same-origin HTTPS check di production.' : 'Credential bootstrap with a same-origin HTTPS check in production.'}</p></div>
    <div class="border border-[#262626] rounded-lg p-5"><p class="text-xs uppercase tracking-wider text-[#52525b]">API key</p><p class="text-sm text-[#a1a1aa] mt-2">{id ? 'Session, recipient, message, dan audit API.' : 'Session, recipient, messaging, and audit APIs.'}</p></div>
  </div>

  <h2 class="text-xl font-semibold text-[#fafafa] mb-3">Hybrid API Explorer</h2>
  <p class="text-sm text-[#a1a1aa] leading-relaxed mb-3">{id ? 'Pilih endpoint untuk membuat contoh cURL, JavaScript, Python, atau Node.js. Untuk operator yang ingin mencoba instance sendiri, Base URL dan API key dapat digunakan untuk mengirim request langsung dari browser.' : 'Choose an endpoint to generate cURL, JavaScript, Python, or Node.js examples. Operators can also enter a Base URL and API key to send a request directly from the browser to their own instance.'}</p>
  <p class="text-xs text-[#71717a] mb-4">{id ? 'Generated code tidak pernah menampilkan API key asli. Semua POST meminta konfirmasi; rebind mendapat warning khusus.' : 'Generated code never prints your real API key. Every POST requires confirmation; rebind receives an additional warning.'}</p>
  <Callout title={id ? 'Live request mengikuti browser origin rules' : 'Live requests follow browser origin rules'}>
    {id ? 'Explorer tidak melakukan proxy melalui server dokumentasi. Wago core tidak menambahkan cross-origin response headers, jadi live call hanya bekerja bila deployment Anda memenuhi browser origin rules, misalnya dengan same-origin routing atau reverse proxy yang sengaja dikonfigurasi. Generated snippets tetap dapat digunakan untuk integrasi server-to-server.' : 'The explorer does not proxy through the documentation server. Wago core does not add cross-origin response headers, so live calls only work when your deployment satisfies browser origin rules, for example through same-origin routing or an intentionally configured reverse proxy. Generated snippets remain usable for server-to-server integration.'}
  </Callout>
  <div class="mt-5"><ApiExplorer lang={lang} client:load /></div>

  <h2 class="text-xl font-semibold text-[#fafafa] mt-12 mb-4">{id ? 'Semua endpoint' : 'All endpoints'}</h2>
  <div class="overflow-x-auto mb-10"><table class="w-full text-sm text-left"><thead><tr class="border-b border-[#262626] text-[#71717a]"><th class="py-2.5 pr-4">Method</th><th class="py-2.5 pr-4">Path</th><th class="py-2.5 pr-4">Auth</th><th class="py-2.5">{id ? 'Tujuan' : 'Purpose'}</th></tr></thead><tbody class="divide-y divide-[#1a1a1a] text-[#a1a1aa]">{apiEndpoints.map(endpoint => <tr><td class={`py-3 pr-4 font-mono ${endpoint.method === 'GET' ? 'text-emerald-400' : 'text-blue-400'}`}>{endpoint.method}</td><td class="py-3 pr-4"><code>{endpoint.path}</code></td><td class="py-3 pr-4 text-[#71717a]">{authName(endpoint.auth)}</td><td class="py-3">{endpoint.description[lang]}</td></tr>)}</tbody></table></div>

  <h2 class="text-xl font-semibold text-[#fafafa] mb-4">{id ? 'Alur integrasi aplikasi eksternal' : 'External application flow'}</h2>
  <div class="space-y-5 mb-10">
    <div class="border border-[#262626] rounded-lg p-5"><h3 class="text-sm font-semibold text-[#fafafa]">1. {id ? 'Simpan API key di backend aplikasi' : 'Keep the API key in your application backend'}</h3><CodeBlock label="application .env" code={`WAGO_URL=https://wago.example.com\nWAGO_API_KEY=wa_...`} /><p class="text-xs text-[#71717a]">{id ? 'Secret ini bukan untuk public frontend bundle.' : 'This secret does not belong in a public frontend bundle.'}</p></div>
    <div class="border border-[#262626] rounded-lg p-5"><h3 class="text-sm font-semibold text-[#fafafa]">2. {id ? 'Allow recipient saat ada permission' : 'Allow a recipient when permission exists'}</h3><CodeBlock label="cURL" code={`curl -X POST "$WAGO_URL/recipients/allow" \\\n  -H "Authorization: Bearer $WAGO_API_KEY" \\\n  -H "Content-Type: application/json" \\\n  -d '{"phone":"6281234567890","label":"Example recipient"}'`} /><p class="text-xs text-[#71717a]">{id ? 'Lakukan ketika aplikasi Anda mencatat consent/permission, bukan sebelum setiap send.' : 'Do this when your application records real consent/permission, not before every send.'}</p></div>
    <div class="border border-[#262626] rounded-lg p-5"><h3 class="text-sm font-semibold text-[#fafafa]">3. {id ? 'Kirim text dengan idempotency key' : 'Send text with an idempotency key'}</h3><CodeBlock label="cURL" code={`curl -X POST "$WAGO_URL/messages/send" \\\n  -H "Authorization: Bearer $WAGO_API_KEY" \\\n  -H "Content-Type: application/json" \\\n  -H "Idempotency-Key: notification-123" \\\n  -d '{"to":"6281234567890","text":"Hello from Wago"}'`} /><CodeBlock label="202" code={`{\n  "success": true,\n  "messageId": "...",\n  "status": "pending"\n}`} /></div>
    <div class="border border-[#262626] rounded-lg p-5"><h3 class="text-sm font-semibold text-[#fafafa]">4. {id ? 'Cek status bila diperlukan' : 'Inspect status when needed'}</h3><CodeBlock label="cURL" code={`curl "$WAGO_URL/messages/<message-id>/status" \\\n  -H "Authorization: Bearer $WAGO_API_KEY"`} /><p class="text-xs text-[#71717a]">{id ? 'Status yang tersedia saat ini: pending, accepted, rejected. Tidak ada claim delivered/read/played.' : 'Current states are pending, accepted, and rejected. Wago does not claim delivered/read/played receipts.'}</p></div>
  </div>

  <Callout title={id ? '202 pending bukan delivered' : '202 pending is not delivered'} tone="warning">{id ? 'HTTP 202 berarti Wago/Baileys menerima operasi outbound dan membuat status awal. Event WhatsApp berikutnya dapat mengubah retained status menjadi accepted atau rejected.' : 'HTTP 202 means Wago/Baileys accepted the outbound operation and created its initial status. A later WhatsApp event may move the retained state to accepted or rejected.'}</Callout>

  <h2 class="text-xl font-semibold text-[#fafafa] mt-10 mb-3">POST /app/bootstrap</h2>
  <p class="text-sm text-[#a1a1aa] leading-relaxed mb-4">{id ? 'Fresh gateway dapat menerima kandidat API key berformat wa_. Di production, request bootstrap harus memiliki Origin HTTPS dan host Origin harus sama dengan Host request. Setelah credential tersedia, bootstrap bukan endpoint rotasi key umum.' : 'A fresh gateway can accept a wa_-prefixed API-key candidate. In production, bootstrap requires an HTTPS Origin and the Origin host must match the request Host. Once credentials exist, bootstrap is not a general key-rotation endpoint.'}</p>
  <CodeBlock label="request" code={`{\n  "apiKey": "wa_<random-candidate>"\n}`} />
  <p class="text-sm text-[#71717a] mb-8">{id ? 'Response sukses menggunakan 201 untuk initial creation atau 200 ketika browser memulihkan akses dengan credential yang sudah ada. Generated raw key tidak disimpan server; backend menyimpan hash-nya di SQLite.' : 'Successful responses use 201 for initial creation or 200 when the browser recovers access using existing credentials. The generated raw key is not stored by the server; its hash is persisted in SQLite.'}</p>

  <h2 class="text-xl font-semibold text-[#fafafa] mb-3">GET /whatsapp/status</h2>
  <p class="text-sm text-[#a1a1aa] leading-relaxed mb-4">{id ? 'Endpoint ini menggabungkan status koneksi, binding persisten, dan account-health snapshot. accountHealth.availability dapat bernilai unavailable, checking, atau available; unavailableReason dapat menjelaskan not_connected, session_invalid, atau fetch_failed.' : 'This endpoint combines connection state, persistent binding, and the account-health snapshot. accountHealth.availability can be unavailable, checking, or available; unavailableReason can explain not_connected, session_invalid, or fetch_failed.'}</p>
  <Callout title={id ? 'Connected tidak sama dengan bebas restriction' : 'Connected does not mean unrestricted'}>{id ? 'Reachout Time-lock dan New Chat Cap adalah sinyal WhatsApp/Baileys yang Wago gunakan secara defensif. Sinyal tersebut bukan jaminan account safety.' : 'Reachout Time-lock and New Chat Cap are WhatsApp/Baileys signals used defensively by Wago. They are not guarantees of account safety.'}</Callout>

  <h2 class="text-xl font-semibold text-[#fafafa] mt-10 mb-3">{id ? 'QR pairing dan versi WhatsApp Web' : 'QR pairing and WhatsApp Web version'}</h2>
  <p class="text-sm text-[#a1a1aa] leading-relaxed mb-8">{id ? 'Saat lifecycle membuat socket baru, Wago mencoba resolve versi WhatsApp Web terbaru melalui Baileys dan meng-cache hasil sukses selama proses berjalan. Jika lookup gagal, socket dibuat dengan versi default/bundled Baileys sebagai fallback.' : 'When the lifecycle creates a new socket, Wago attempts to resolve the latest WhatsApp Web version through Baileys and caches a successful result for the process lifetime. If lookup fails, the socket is created with the Baileys default/bundled version as a fallback.'}</p>

  <h2 class="text-xl font-semibold text-[#fafafa] mb-3">GET /activity</h2>
  <p class="text-sm text-[#a1a1aa] leading-relaxed mb-4">{id ? 'Audit query dilakukan di SQLite. Event Baileys disanitasi sebelum persistence; endpoint ini bukan raw protocol dump.' : 'Audit queries run in SQLite. Baileys events are sanitized before persistence; this endpoint is not a raw protocol dump.'}</p>
  <div class="overflow-x-auto mb-5"><table class="w-full text-sm"><thead><tr class="border-b border-[#262626] text-[#71717a]"><th class="py-2 pr-4 text-left">Query</th><th class="py-2 text-left">{id ? 'Nilai' : 'Values'}</th></tr></thead><tbody class="divide-y divide-[#1a1a1a] text-[#a1a1aa]"><tr><td class="py-3 pr-4"><code>source</code></td><td><code>wago | baileys</code></td></tr><tr><td class="py-3 pr-4"><code>category</code></td><td><code>system | security | connection | recipient | messaging</code></td></tr><tr><td class="py-3 pr-4"><code>level</code></td><td><code>info | success | warning | error</code></td></tr><tr><td class="py-3 pr-4"><code>q</code></td><td>Search code/title/description.</td></tr><tr><td class="py-3 pr-4"><code>before</code></td><td>{id ? 'Cursor dari nextCursor halaman sebelumnya.' : 'Cursor from the previous page nextCursor.'}</td></tr><tr><td class="py-3 pr-4"><code>limit</code></td><td>{id ? 'Default 100; query layer clamp 1..200.' : 'Default 100; query layer clamps to 1..200.'}</td></tr></tbody></table></div>
  <CodeBlock label="response" code={`{\n  "success": true,\n  "events": [],\n  "nextCursor": "..."\n}`} />

  <h2 class="text-xl font-semibold text-[#fafafa] mt-10 mb-4">Error model</h2>
  <CodeBlock label="error" code={`{\n  "success": false,\n  "error": "ERROR_CODE",\n  "message": "Human-readable message"\n}`} />
  <div class="overflow-x-auto mt-5"><table class="w-full text-sm"><thead><tr class="border-b border-[#262626] text-[#71717a]"><th class="py-2.5 pr-4">HTTP</th><th class="py-2.5 pr-4">Code</th><th class="py-2.5 text-left">{id ? 'Arti' : 'Meaning'}</th></tr></thead><tbody class="divide-y divide-[#1a1a1a] text-[#a1a1aa]"><tr><td class="py-3 pr-4 text-[#fafafa]">400</td><td class="pr-4"><code>INVALID_REQUEST / INVALID_PHONE / INVALID_JSON / INVALID_API_KEY / INVALID_AUDIT_FILTER / INVALID_AUDIT_CURSOR</code></td><td>{id ? 'Input/query/body tidak valid.' : 'Invalid input, query, or body.'}</td></tr><tr><td class="py-3 pr-4 text-[#fafafa]">401</td><td class="pr-4"><code>UNAUTHORIZED</code></td><td>{id ? 'Bearer key/cookie tidak valid.' : 'Invalid Bearer key or cookie.'}</td></tr><tr><td class="py-3 pr-4 text-[#fafafa]">403</td><td class="pr-4"><code>API_KEY_REQUIRED / WEB_BOOTSTRAP_DISABLED / INVALID_SETUP_ORIGIN / INVALID_ORIGIN / RECIPIENT_NOT_ALLOWED / RECIPIENT_OPTED_OUT</code></td><td>{id ? 'Setup/auth/policy menolak operasi.' : 'Setup, auth, or policy rejected the operation.'}</td></tr><tr><td class="py-3 pr-4 text-[#fafafa]">404</td><td class="pr-4"><code>PHONE_NOT_ON_WHATSAPP / MESSAGE_STATUS_NOT_FOUND</code></td><td>{id ? 'Recipient/status tidak ditemukan.' : 'Recipient or retained status not found.'}</td></tr><tr><td class="py-3 pr-4 text-[#fafafa]">409</td><td class="pr-4"><code>DUPLICATE_MESSAGE / APP_ALREADY_INITIALIZED</code></td><td>{id ? 'Konflik idempotency/bootstrap.' : 'Idempotency or bootstrap conflict.'}</td></tr><tr><td class="py-3 pr-4 text-[#fafafa]">413</td><td class="pr-4"><code>PAYLOAD_TOO_LARGE</code></td><td>{id ? 'JSON body melewati limit 32kb.' : 'JSON body exceeds the 32kb limit.'}</td></tr><tr><td class="py-3 pr-4 text-[#fafafa]">429</td><td class="pr-4"><code>*_RATE_LIMITED / WA_REACHOUT_RESTRICTED / WA_NEW_CHAT_CAPPED / REACHOUT_RESTRICTED</code></td><td>{id ? 'Local policy atau WhatsApp reach-out guard aktif.' : 'A local policy or WhatsApp reach-out guard is active.'}</td></tr><tr><td class="py-3 pr-4 text-[#fafafa]">502</td><td class="pr-4"><code>MESSAGE_REJECTED</code></td><td>{id ? 'WhatsApp menolak send setelah attempt.' : 'WhatsApp rejected the send after it was attempted.'}</td></tr><tr><td class="py-3 pr-4 text-[#fafafa]">503</td><td class="pr-4"><code>WHATSAPP_NOT_CONNECTED / OUTBOUND_PAUSED</code></td><td>{id ? 'Gateway tidak siap untuk outbound.' : 'The gateway is not ready for outbound sending.'}</td></tr><tr><td class="py-3 pr-4 text-[#fafafa]">500</td><td class="pr-4"><code>SEND_MESSAGE_FAILED / PAIRING_FAILED / REBIND_FAILED</code></td><td>{id ? 'Failure internal pada operasi terkait.' : 'Internal failure in the requested operation.'}</td></tr></tbody></table></div>

  <h2 class="text-xl font-semibold text-[#fafafa] mt-10 mb-4">{id ? 'Rate limit dan outbound safety' : 'Rate limits and outbound safety'}</h2>
  <ul class="list-disc pl-5 text-sm text-[#a1a1aa] space-y-2 mb-5"><li>{id ? 'Route /messages/send: 30 HTTP request per menit.' : '/messages/send route: 30 HTTP requests per minute.'}</li><li>{id ? '/whatsapp/pair dan /whatsapp/rebind: masing-masing 5 request per menit.' : '/whatsapp/pair and /whatsapp/rebind: 5 requests per minute each.'}</li><li>{id ? 'Account outbound: 30 accepted send per 60 detik.' : 'Account outbound: 30 accepted sends per 60 seconds.'}</li><li>{id ? 'Per recipient: 5 accepted send per 60 detik.' : 'Per recipient: 5 accepted sends per 60 seconds.'}</li><li>{id ? 'New chat: 10 recipient baru per jam.' : 'New chat: 10 new recipients per hour.'}</li></ul>
  <Callout title={id ? 'Bukan threshold resmi WhatsApp' : 'Not official WhatsApp thresholds'} tone="warning">{id ? 'Angka di atas adalah guardrail lokal Wago. Baileys adalah client WhatsApp Web tidak resmi; Wago tidak dapat menjamin account tidak akan terkena restriction atau ban.' : 'These numbers are Wago-local guardrails. Baileys is an unofficial WhatsApp Web client; Wago cannot guarantee that an account will avoid restrictions or bans.'}</Callout>
</DocsLayout>
