---
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="mb-9">
  {eyebrow ? <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[#10b981] mb-3">{eyebrow}</p> : null}
  <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#fafafa] mb-4">{title}</h1>
  <p class="text-base sm:text-lg text-[#a1a1aa] leading-relaxed max-w-3xl">{description}</p>
</header>
