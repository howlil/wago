---
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="mb-10 border-b border-[var(--docs-line)] pb-7">
  {eyebrow ? <p class="docs-page-kicker">{eyebrow}</p> : null}
  <h1 class="docs-page-title">{title}</h1>
  <p class="docs-page-description">{description}</p>
</header>
