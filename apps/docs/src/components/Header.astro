---
import { getLangFromUrl } from '../utils/i18n';

const lang = getLangFromUrl(Astro.url);
const currentPath = Astro.url.pathname;
const targetLang = lang === 'en' ? 'id' : 'en';
const basePrefix = lang === 'en' ? '/en' : '/id';

let targetUrl = currentPath;
if (lang === 'en') {
  targetUrl = currentPath === '/' || currentPath === '/en' || currentPath === '/en/'
    ? '/id'
    : currentPath.startsWith('/en/')
      ? currentPath.replace('/en/', '/id/')
      : `/id${currentPath}`;
} else {
  targetUrl = currentPath === '/id' || currentPath === '/id/'
    ? '/en'
    : currentPath.startsWith('/id/')
      ? currentPath.replace('/id/', '/en/')
      : `/en${currentPath}`;
}
---

<header class="docs-topbar sticky top-0 z-50">
  <div class="docs-shell flex h-14 items-center justify-between gap-4">
    <div class="flex min-w-0 items-center gap-5">
      <a href={basePrefix} class="docs-text text-[15px] font-semibold tracking-[-0.02em] hover:opacity-80">
        Wago
      </a>
      <span class="hidden h-4 w-px bg-[var(--docs-line)] sm:block"></span>
      <a
        href={`${basePrefix}/docs`}
        aria-current={currentPath.includes('/docs') ? 'page' : undefined}
        class={`hidden text-[13px] font-medium sm:inline ${currentPath.includes('/docs') ? 'docs-text' : 'docs-tertiary hover:docs-text-soft'}`}
      >
        {lang === 'id' ? 'Dokumentasi' : 'Documentation'}
      </a>
    </div>

    <nav class="flex items-center gap-1 text-[12px]" aria-label={lang === 'id' ? 'Navigasi situs' : 'Site navigation'}>
      <a
        href="https://github.com/howlil/wago"
        target="_blank"
        rel="noreferrer"
        class="docs-tertiary hidden px-2 py-1.5 hover:text-[var(--docs-text-soft)] md:inline"
      >
        GitHub
      </a>
      <a
        href="https://github.com/howlil/wago/pkgs/container/wago-simple"
        target="_blank"
        rel="noreferrer"
        class="docs-tertiary hidden px-2 py-1.5 hover:text-[var(--docs-text-soft)] sm:inline"
      >
        Container
      </a>
      <a
        href={targetUrl}
        class="docs-tertiary border-l border-[var(--docs-line)] px-3 py-1.5 font-medium hover:text-[var(--docs-text)]"
        aria-label={lang === 'id' ? 'Switch to English' : 'Ganti ke Bahasa Indonesia'}
      >
        {targetLang.toUpperCase()}
      </a>
    </nav>
  </div>
</header>
