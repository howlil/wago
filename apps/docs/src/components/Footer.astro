---
import { getLangFromUrl } from '../utils/i18n';

const lang = getLangFromUrl(Astro.url);
const basePrefix = lang === 'en' ? '/en' : '/id';
---

<footer class="mt-20 border-t border-[var(--docs-line)] py-8">
  <div class="docs-shell flex flex-col gap-5 text-[12px] sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="m-0 docs-muted">Wago — single-account, self-hosted WhatsApp gateway.</p>
      <p class="m-0 mt-1 docs-tertiary">Unofficial WhatsApp Web client. Not affiliated with WhatsApp or Meta.</p>
    </div>
    <nav class="flex flex-wrap gap-x-4 gap-y-2 docs-tertiary" aria-label="Footer navigation">
      <a href={`${basePrefix}/docs`} class="hover:text-[var(--docs-text-soft)]">Docs</a>
      <a href={`${basePrefix}/docs/project`} class="hover:text-[var(--docs-text-soft)]">Project</a>
      <a href="https://github.com/howlil/wago/blob/main/SECURITY.md" target="_blank" rel="noreferrer" class="hover:text-[var(--docs-text-soft)]">Security</a>
      <a href="https://github.com/howlil/wago/blob/main/LICENSE" target="_blank" rel="noreferrer" class="hover:text-[var(--docs-text-soft)]">MIT</a>
      <a href="https://github.com/howlil/wago" target="_blank" rel="noreferrer" class="hover:text-[var(--docs-text-soft)]">GitHub</a>
    </nav>
  </div>
</footer>
