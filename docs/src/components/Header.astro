---
import { getLangFromUrl } from '../utils/i18n';

const lang = getLangFromUrl(Astro.url);
const currentPath = Astro.url.pathname;
const targetLang = lang === 'en' ? 'id' : 'en';
const basePrefix = lang === 'en' ? '/en' : '/id';

let targetUrl = currentPath;
if (lang === 'en') {
  targetUrl = currentPath === '/' || currentPath === '/en' || currentPath === '/en/'
    ? '/id'
    : currentPath.startsWith('/en/')
      ? currentPath.replace('/en/', '/id/')
      : `/id${currentPath}`;
} else {
  targetUrl = currentPath === '/id' || currentPath === '/id/'
    ? '/en'
    : currentPath.startsWith('/id/')
      ? currentPath.replace('/id/', '/en/')
      : `/en${currentPath}`;
}
---

<header class="sticky top-0 z-50 bg-[#0a0a0a]/95 backdrop-blur-sm border-b border-[#262626]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
    <div class="flex items-center gap-5">
      <a href={basePrefix} class="text-[#fafafa] font-semibold text-[15px] tracking-tight hover:opacity-80 transition-opacity">
        Wago
      </a>
      <span class="hidden sm:inline text-[11px] px-2 py-1 rounded border border-[#262626] text-[#71717a]">OSS</span>
    </div>

    <nav class="hidden md:flex items-center gap-1">
      <a
        href={`${basePrefix}/docs`}
        class={`px-3 py-1.5 rounded-md text-sm transition-colors ${
          currentPath.includes('/docs') ? 'text-[#fafafa] bg-[#1a1a1a]' : 'text-[#71717a] hover:text-[#d4d4d8]'
        }`}
      >
        {lang === 'id' ? 'Dokumentasi' : 'Documentation'}
      </a>
      <a
        href="https://github.com/howlil/wago"
        target="_blank"
        rel="noreferrer"
        class="px-3 py-1.5 rounded-md text-sm text-[#71717a] hover:text-[#d4d4d8] transition-colors"
      >
        GitHub
      </a>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={targetUrl}
        class="px-2.5 py-1 rounded-md text-xs text-[#71717a] hover:text-[#d4d4d8] hover:bg-[#1a1a1a] transition-colors"
        aria-label={lang === 'id' ? 'Switch to English' : 'Ganti ke Bahasa Indonesia'}
      >
        {targetLang.toUpperCase()}
      </a>
      <a
        href="https://github.com/howlil/wago/pkgs/container/wago-simple"
        target="_blank"
        rel="noreferrer"
        class="px-3 py-1.5 rounded-md text-sm font-medium text-[#0a0a0a] bg-[#fafafa] hover:bg-[#e4e4e7] transition-colors"
      >
        GHCR
      </a>
    </div>
  </div>
</header>
