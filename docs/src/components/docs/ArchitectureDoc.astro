---
import DocsLayout from '../../layouts/DocsLayout.astro';
import PageHeader from './PageHeader.astro';
import Callout from './Callout.astro';
import PlantUmlDiagram from './PlantUmlDiagram.astro';

interface Props { lang: 'en' | 'id' }
const { lang } = Astro.props;
const id = lang === 'id';
---

<DocsLayout title={id ? 'Arsitektur' : 'Architecture'}>
  <PageHeader eyebrow="Internals" title={id ? 'Arsitektur aplikasi' : 'Application architecture'} description={id ? 'Satu proses Node.js menyajikan API dan dashboard React, menjalankan outbound policy, memakai SQLite untuk state durable, dan memelihara satu koneksi Baileys.' : 'One Node.js process serves the API and React dashboard, runs outbound policy, uses SQLite for durable state, and maintains one Baileys connection.'} />

  <PlantUmlDiagram file="system-architecture.puml" alt="Wago runtime architecture" caption={id ? 'Arsitektur runtime production Wago.' : 'Wago production runtime architecture.'} />

  <h2 class="text-xl font-semibold text-[#fafafa] mb-4">Backend</h2>
  <div class="overflow-x-auto mb-9"><table class="w-full text-sm"><tbody class="divide-y divide-[#1a1a1a]">
    <tr><td class="py-3 pr-5 text-[#fafafa] font-medium">config/</td><td class="py-3 text-[#a1a1aa]">{id ? 'Environment, runtime paths, App ID, API-key hash, dan validasi production.' : 'Environment, runtime paths, App ID, API-key hash, and production validation.'}</td></tr>
    <tr><td class="py-3 pr-5 text-[#fafafa] font-medium">infrastructure/</td><td class="py-3 text-[#a1a1aa]">{id ? 'SQLite, schema migration, transaction, import state JSON lama, dan logging.' : 'SQLite, schema migrations, transactions, legacy JSON import, and logging.'}</td></tr>
    <tr><td class="py-3 pr-5 text-[#fafafa] font-medium">middleware/</td><td class="py-3 text-[#a1a1aa]">{id ? 'Bearer/cookie auth, Origin protection, request logging, dan route limiter.' : 'Bearer/cookie auth, Origin protection, request logging, and route limiting.'}</td></tr>
    <tr><td class="py-3 pr-5 text-[#fafafa] font-medium">routes/</td><td class="py-3 text-[#a1a1aa]">{id ? 'Kontrak HTTP app, activity, recipients, WhatsApp, dan messages.' : 'HTTP contracts for app, activity, recipients, WhatsApp, and messages.'}</td></tr>
    <tr><td class="py-3 pr-5 text-[#fafafa] font-medium">policy/</td><td class="py-3 text-[#a1a1aa]">{id ? 'Permission, opt-out, idempotency, outbound windows, pause/cooldown, dan account-health gates.' : 'Permission, opt-out, idempotency, outbound windows, pause/cooldown, and account-health gates.'}</td></tr>
    <tr><td class="py-3 pr-5 text-[#fafafa] font-medium">recipients/</td><td class="py-3 text-[#a1a1aa]">{id ? 'Recipient policy, resolved JID, dan successful-outbound metadata di SQLite.' : 'Recipient policy, resolved JID, and successful-outbound metadata in SQLite.'}</td></tr>
    <tr><td class="py-3 pr-5 text-[#fafafa] font-medium">activity/</td><td class="py-3 text-[#a1a1aa]">{id ? 'Structured audit Wago/Baileys, sanitizer, SQLite filters/cursor pagination, dan retention 2.000 event.' : 'Structured Wago/Baileys audit, sanitizer, SQLite filtering/cursor pagination, and 2,000-event retention.'}</td></tr>
    <tr><td class="py-3 pr-5 text-[#fafafa] font-medium">whatsapp/</td><td class="py-3 text-[#a1a1aa]">{id ? 'Socket lifecycle, QR, reconnect, binding, account health, recipient resolution, dan recent message status.' : 'Socket lifecycle, QR, reconnect, binding, account health, recipient resolution, and recent message status.'}</td></tr>
  </tbody></table></div>

  <h2 class="text-xl font-semibold text-[#fafafa] mb-4">Frontend</h2>
  <p class="text-sm text-[#a1a1aa] leading-relaxed mb-5">{id ? 'React menggunakan relative API base pada production sehingga Express menyajikan UI dan API dari origin yang sama. API key yang dimasukkan operator berada di sessionStorage browser dashboard; bootstrap juga dapat membuat HttpOnly cookie.' : 'React uses a relative API base in production so Express serves UI and API from the same origin. An operator-entered API key is held in dashboard sessionStorage; bootstrap can also create an HttpOnly cookie.'}</p>
  <ul class="list-disc pl-5 text-sm text-[#a1a1aa] space-y-2 mb-9"><li>{id ? 'Dashboard mengelola pairing/rebind, recipient access, manual text send/status, account health, dan operational activity.' : 'The dashboard manages pairing/rebind, recipient access, manual text send/status, account health, and operational activity.'}</li><li>{id ? 'Public Astro docs merupakan artifact terpisah dan tidak dibundle ke runtime production Wago.' : 'The public Astro docs are a separate artifact and are not bundled into the Wago production runtime.'}</li></ul>

  <h2 class="text-xl font-semibold text-[#fafafa] mb-4">{id ? 'Flow bootstrap dan pairing' : 'Bootstrap and pairing flow'}</h2>
  <PlantUmlDiagram file="bootstrap-pairing-flow.puml" alt="Wago first-run credential bootstrap and WhatsApp pairing flow" caption={id ? 'Credential hash dan account binding berada di SQLite; Baileys auth tetap berada di /app/data/auth.' : 'The credential hash and account binding live in SQLite; Baileys auth remains under /app/data/auth.'} />

  <h2 class="text-xl font-semibold text-[#fafafa] mb-4">{id ? 'Flow outbound message' : 'Outbound message flow'}</h2>
  <PlantUmlDiagram file="outbound-message-flow.puml" alt="Wago protected outbound text-message flow" caption={id ? 'Policy Wago dievaluasi sebelum outbound text diteruskan ke Baileys.' : 'Wago policy is evaluated before outbound text is passed to Baileys.'} />

  <h2 class="text-xl font-semibold text-[#fafafa] mb-4">{id ? 'Persistent vs transient state' : 'Persistent vs transient state'}</h2>
  <div class="grid sm:grid-cols-2 gap-4 mb-8"><div class="border border-[#262626] rounded-lg p-5"><h3 class="font-semibold text-sm text-[#fafafa] mb-2">Persistent</h3><ul class="text-sm text-[#71717a] space-y-1.5"><li><code>/app/data/wago.db</code> — settings, binding, recipients, outbound safety, audit</li><li><code>/app/data/auth/</code> — {id ? 'credential/session Baileys' : 'Baileys credentials/session'}</li></ul></div><div class="border border-[#262626] rounded-lg p-5"><h3 class="font-semibold text-sm text-[#fafafa] mb-2">Transient</h3><ul class="text-sm text-[#71717a] space-y-1.5"><li>{id ? 'QR dan connection/reconnect snapshot' : 'QR and connection/reconnect snapshot'}</li><li>{id ? 'account-health cache' : 'account-health cache'}</li><li>{id ? 'recent message-status cache' : 'recent message-status cache'}</li></ul></div></div>

  <h2 class="text-xl font-semibold text-[#fafafa] mb-3">SQLite</h2>
  <p class="text-sm text-[#a1a1aa] leading-relaxed mb-5">{id ? 'Wago menggunakan node:sqlite bawaan Node.js tanpa ORM atau database service tambahan. Database memakai WAL, migration table, prepared statements, busy timeout, dan index untuk query outbound/audit.' : 'Wago uses Node.js built-in node:sqlite without an ORM or separate database service. The database uses WAL, a migration table, prepared statements, a busy timeout, and indexes for outbound/audit queries.'}</p>
  <Callout title={id ? 'Legacy JSON hanya jalur migrasi' : 'Legacy JSON is migration-only'}>{id ? 'Versi lama dapat di-import sekali ke SQLite. Setelah marker import tercatat, runtime menggunakan wago.db sebagai application-state source of truth; file JSON lama hanya recovery artifact.' : 'Legacy state can be imported once into SQLite. After the import marker is recorded, wago.db becomes the application-state source of truth; old JSON files are recovery artifacts only.'}</Callout>
  <Callout title={id ? 'Skalabilitas sengaja dibatasi' : 'Scaling is intentionally constrained'} tone="warning">{id ? 'Jangan jalankan beberapa replica terhadap /app/data yang sama. Model ini single-process/single-account dan tidak dirancang untuk horizontal scaling atau distributed rate limiting.' : 'Do not run multiple replicas against the same /app/data volume. This is a single-process/single-account model and is not designed for horizontal scaling or distributed rate limiting.'}</Callout>
</DocsLayout>
