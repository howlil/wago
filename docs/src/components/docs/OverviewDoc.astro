---
import DocsLayout from '../../layouts/DocsLayout.astro';
import PageHeader from './PageHeader.astro';
import Callout from './Callout.astro';
import DocCard from './DocCard.astro';
import PlantUmlDiagram from './PlantUmlDiagram.astro';

interface Props { lang: 'en' | 'id' }
const { lang } = Astro.props;
const id = lang === 'id';
const base = id ? '/id' : '/en';
---

<DocsLayout
  title={id ? 'Ringkasan' : 'Overview'}
  description={id ? 'Peta kemampuan, batasan, arsitektur, dan dokumentasi Wago.' : 'A map of Wago capabilities, boundaries, architecture, and documentation.'}
>
  <PageHeader
    eyebrow="Wago"
    title={id ? 'Gateway WhatsApp self-hosted yang sengaja dibuat sederhana' : 'A deliberately small, self-hosted WhatsApp gateway'}
    description={id
      ? 'Wago menghubungkan satu akun WhatsApp melalui Baileys dan menyediakan REST API terautentikasi, dashboard web, state persisten, activity log, serta policy outbound untuk integrasi yang terkontrol.'
      : 'Wago connects one WhatsApp account through Baileys and exposes an authenticated REST API, web dashboard, persistent state, an activity log, and outbound policy controls for focused integrations.'}
  />

  <Callout title={id ? 'Batas produk' : 'Product boundary'} tone="warning">
    {id
      ? 'Wago bukan bulk sender, campaign platform, multi-tenant SaaS, scraper nomor, atau sistem anti-detection. Satu instance ditujukan untuk satu akun WhatsApp dan satu direktori data.'
      : 'Wago is not a bulk sender, campaign platform, multi-tenant SaaS, number scraper, or anti-detection system. One instance is designed for one WhatsApp account and one data directory.'}
  </Callout>

  <h2 class="text-xl font-semibold text-[#fafafa] mt-10 mb-4">{id ? 'Kemampuan inti' : 'Core capabilities'}</h2>
  <div class="grid sm:grid-cols-2 gap-4 mb-10">
    <div class="border border-[#262626] rounded-lg p-5"><h3 class="text-sm font-semibold text-[#fafafa] mb-2">REST API</h3><p class="text-sm text-[#71717a] leading-relaxed">{id ? 'Bearer/cookie auth, health, bootstrap, pairing, recipient policy, activity, text send, dan retained status.' : 'Bearer/cookie auth, health, bootstrap, pairing, recipient policy, activity, text sending, and retained status.'}</p></div>
    <div class="border border-[#262626] rounded-lg p-5"><h3 class="text-sm font-semibold text-[#fafafa] mb-2">Dashboard</h3><p class="text-sm text-[#71717a] leading-relaxed">{id ? 'Status gateway/WhatsApp, credential bootstrap otomatis saat pairing, QR pairing, rebind, recipient access, manual send, account health, dan activity log.' : 'Gateway/WhatsApp status, automatic credential bootstrap during pairing, QR pairing, rebind, recipient access, manual sending, account health, and activity log.'}</p></div>
    <div class="border border-[#262626] rounded-lg p-5"><h3 class="text-sm font-semibold text-[#fafafa] mb-2">Persistent state</h3><p class="text-sm text-[#71717a] leading-relaxed">{id ? 'Auth Baileys, app settings, recipient records, account binding, dan operator activity log disimpan di /app/data.' : 'Baileys auth, app settings, recipient records, account binding, and the operator activity log are stored under /app/data.'}</p></div>
    <div class="border border-[#262626] rounded-lg p-5"><h3 class="text-sm font-semibold text-[#fafafa] mb-2">Outbound policy</h3><p class="text-sm text-[#71717a] leading-relaxed">{id ? 'Allowlist, opt-out, idempotency, account/recipient/new-chat limits, serta pemeriksaan health/reach-out sebelum send.' : 'Allowlist, opt-out, idempotency, account/recipient/new-chat limits, and account-health/reach-out checks before sending.'}</p></div>
  </div>

  <h2 class="text-xl font-semibold text-[#fafafa] mb-4">{id ? 'Model sistem' : 'System model'}</h2>
  <PlantUmlDiagram
    file="system-architecture.puml"
    alt="Wago runtime architecture overview"
    caption={id ? 'Source diagram disimpan sebagai PlantUML bersama dokumentasi.' : 'The diagram source is stored as PlantUML alongside the documentation.'}
  />

  <h2 class="text-xl font-semibold text-[#fafafa] mb-4">{id ? 'Dokumentasi' : 'Documentation map'}</h2>
  <div class="grid sm:grid-cols-2 gap-4">
    <DocCard href={`${base}/docs/getting-started`} title={id ? 'Memulai' : 'Getting Started'} description={id ? 'Deploy tanpa .env, Pair WhatsApp untuk membuat credential, allow recipient, lalu kirim pesan pertama.' : 'Deploy without .env, Pair WhatsApp to create credentials, allow a recipient, and send the first message.'} />
    <DocCard href={`${base}/docs/architecture`} title={id ? 'Arsitektur' : 'Architecture'} description={id ? 'Runtime, bootstrap/pairing, outbound flow, state, dan lifecycle.' : 'Runtime, bootstrap/pairing, outbound flow, state, and lifecycle internals.'} />
    <DocCard href={`${base}/docs/api`} title={id ? 'Referensi API' : 'API Reference'} description={id ? 'Endpoint, autentikasi, payload, error, activity, dan limit.' : 'Endpoints, authentication, payloads, errors, activity, and limits.'} />
    <DocCard href={`${base}/docs/configuration`} title={id ? 'Konfigurasi' : 'Configuration'} description={id ? 'Zero-config production, same-origin otomatis, dan default runtime internal.' : 'Zero-config production, automatic same-origin protection, and internal runtime defaults.'} />
    <DocCard href={`${base}/docs/deployment`} title="Deployment" description={id ? 'GHCR, Docker Compose, proxy, persistence, backup, dan upgrade.' : 'GHCR, Docker Compose, proxying, persistence, backup, and upgrades.'} />
    <DocCard href={`${base}/docs/operations`} title={id ? 'Operasional' : 'Operations'} description={id ? 'Health, activity, logs, session lifecycle, status pesan, dan troubleshooting.' : 'Health, activity, logs, session lifecycle, message status, and troubleshooting.'} />
    <DocCard href={`${base}/docs/development`} title="Development" description={id ? 'Toolchain, local workflow, test, build, dan standar PR.' : 'Toolchain, local workflow, tests, builds, and PR standards.'} />
    <DocCard href={`${base}/docs/project`} title={id ? 'Project & Community' : 'Project & Community'} description={id ? 'Security, kontribusi, release, support, license, dan conduct.' : 'Security, contributing, releases, support, license, and conduct.'} />
  </div>
</DocsLayout>
