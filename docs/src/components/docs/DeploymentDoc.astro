---
import DocsLayout from '../../layouts/DocsLayout.astro';
import PageHeader from './PageHeader.astro';
import Callout from './Callout.astro';
import CodeBlock from './CodeBlock.astro';
interface Props { lang: 'en' | 'id' }
const { lang } = Astro.props;
const id = lang === 'id';
---

<DocsLayout title="Deployment">
  <PageHeader
    eyebrow="Docker / GHCR"
    title={id ? 'Deployment production' : 'Production deployment'}
    description={id ? 'Satu container, satu account, satu persistent volume, satu active instance.' : 'One container, one account, one persistent volume, one active instance.'}
  />

  <h2 class="text-xl font-semibold text-[#fafafa] mb-3">GHCR</h2>
  <CodeBlock label="image" code={`ghcr.io/howlil/wago-simple:latest\nghcr.io/howlil/wago-simple:edge\nghcr.io/howlil/wago-simple:sha-<short-sha>\nghcr.io/howlil/wago-simple:<semver>`} />
  <p class="text-sm text-[#a1a1aa] leading-relaxed mb-4">{id ? 'latest hanya menunjuk stable SemVer. edge/sha-* berasal dari green main untuk integration testing.' : 'latest points only to a stable SemVer release. edge/sha-* come from green main for integration testing.'}</p>
  <Callout title={id ? 'Production reproducible' : 'Reproducible production'}>{id ? 'Pin SemVer atau immutable digest. Jangan pin edge untuk production.' : 'Pin a SemVer or immutable digest. Do not pin edge for production.'}</Callout>

  <h2 class="text-xl font-semibold text-[#fafafa] mt-9 mb-3">Docker Compose</h2>
  <CodeBlock label="shell" code={`git clone https://github.com/howlil/wago.git\ncd wago\nexport WAGO_ADMIN_PASSWORD="$(openssl rand -base64 32)"\ndocker compose pull\ndocker compose up -d\ncurl http://127.0.0.1:3000/health`} />
  <p class="text-sm text-[#71717a] mb-8">{id ? 'Buka dashboard melalui HTTPS, sign in, lalu Pair WhatsApp. Machine key dibuat saat first pairing jika API_KEY tidak dipre-provision.' : 'Open the dashboard through HTTPS, sign in, then Pair WhatsApp. A machine key is created during first pairing when API_KEY is not pre-provisioned.'}</p>

  <h2 class="text-xl font-semibold text-[#fafafa] mb-3">{id ? 'Storage dan ownership' : 'Storage and ownership'}</h2>
  <div class="border border-[#262626] rounded-lg divide-y divide-[#262626] text-sm mb-4">
    <div class="p-4"><code class="text-[#fafafa]">/app/data/wago.db</code><p class="text-[#71717a] mt-1">SQLite durable application state.</p></div>
    <div class="p-4"><code class="text-[#fafafa]">/app/data/auth/</code><p class="text-[#71717a] mt-1">Baileys credential/session state.</p></div>
  </div>
  <Callout title={id ? 'Satu instance aktif' : 'One active instance'} tone="warning">{id ? 'Gunakan replica=1 dan stop-old-before-start-new. Production menolak disposable /app/data dan overlapping owner.' : 'Use replica=1 and stop-old-before-start-new. Production rejects disposable /app/data and overlapping owners.'}</Callout>

  <h2 class="text-xl font-semibold text-[#fafafa] mt-9 mb-3">Backup & restore</h2>
  <p class="text-sm text-[#a1a1aa] mb-4">{id ? 'Stop Wago, snapshot seluruh /app/data, lindungi archive sebagai secret, lalu restore ke volume target sebelum menjalankan tepat satu instance.' : 'Stop Wago, snapshot the entire /app/data, protect the archive as a secret, then restore it to the target volume before running exactly one instance.'}</p>
  <Callout title={id ? 'Migration append-only' : 'Append-only migrations'}>{id ? 'Jangan rewrite released SQLite migration. Kolom lama yang inert lebih aman daripada merusak upgrade history.' : 'Never rewrite a released SQLite migration. Inert old columns are safer than breaking upgrade history.'}</Callout>

  <h2 class="text-xl font-semibold text-[#fafafa] mt-9 mb-3">Upgrade</h2>
  <CodeBlock label="shell" code={`docker compose pull\ndocker compose up -d`} />
  <p class="text-sm text-[#71717a]">{id ? 'Untuk production, pin release/digest. Jangan gunakan docker compose down -v pada upgrade normal.' : 'For production, pin a release/digest. Do not use docker compose down -v during a normal upgrade.'}</p>
</DocsLayout>
