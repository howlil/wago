---
import DocsLayout from '../../layouts/DocsLayout.astro';
import PageHeader from './PageHeader.astro';
import Callout from './Callout.astro';
import CodeBlock from './CodeBlock.astro';

interface Props { lang: 'en' | 'id' }
const { lang } = Astro.props;
const id = lang === 'id';
---

<DocsLayout title={id ? 'Operasional' : 'Operations'}>
  <PageHeader eyebrow="Runbook" title={id ? 'Operasional, audit, dan troubleshooting' : 'Operations, audit, and troubleshooting'} description={id ? 'Gunakan health/readiness untuk proses HTTP, WhatsApp status untuk session truth, dan audit API untuk diagnosis lifecycle yang persisten.' : 'Use health/readiness for HTTP process state, WhatsApp status for session truth, and the audit API for persistent lifecycle diagnosis.'} />

  <h2 class="text-xl font-semibold text-[#fafafa] mb-4">Health & readiness</h2>
  <div class="grid sm:grid-cols-3 gap-4 mb-7"><div class="border border-[#262626] rounded-lg p-5"><code class="text-[#fafafa]">GET /health</code><p class="text-sm text-[#71717a] mt-2">{id ? 'Liveness HTTP. Response: status ok.' : 'HTTP liveness. Response: status ok.'}</p></div><div class="border border-[#262626] rounded-lg p-5"><code class="text-[#fafafa]">GET /ready</code><p class="text-sm text-[#71717a] mt-2">{id ? 'App ID + apakah API credential sudah ada.' : 'App ID + whether an API credential exists.'}</p></div><div class="border border-[#262626] rounded-lg p-5"><code class="text-[#fafafa]">GET /whatsapp/status</code><p class="text-sm text-[#71717a] mt-2">{id ? 'Status session, binding, dan account health.' : 'Session, binding, and account-health state.'}</p></div></div>
  <Callout title={id ? 'Readiness HTTP bukan readiness WhatsApp' : 'HTTP readiness is not WhatsApp readiness'} tone="warning">{id ? '/ready tidak menjamin WhatsApp connected. Selalu gunakan /whatsapp/status untuk keputusan yang membutuhkan session WhatsApp.' : '/ready does not guarantee WhatsApp is connected. Use /whatsapp/status for decisions that require a WhatsApp session.'}</Callout>

  <h2 class="text-xl font-semibold text-[#fafafa] mt-9 mb-3">{id ? 'Status koneksi dan account health' : 'Connection and account-health state'}</h2>
  <div class="overflow-x-auto mb-6"><table class="w-full text-sm"><thead><tr class="border-b border-[#262626] text-[#71717a]"><th class="py-2 pr-4 text-left">Field</th><th class="py-2 text-left">{id ? 'Makna operasional' : 'Operational meaning'}</th></tr></thead><tbody class="divide-y divide-[#1a1a1a] text-[#a1a1aa]"><tr><td class="py-3 pr-4"><code>status=connecting</code></td><td>{id ? 'Socket sedang membangun/memulihkan koneksi.' : 'The socket is establishing or restoring connectivity.'}</td></tr><tr><td class="py-3 pr-4"><code>status=qr</code></td><td>{id ? 'QR tersedia dan perlu dipindai.' : 'A QR is available and must be scanned.'}</td></tr><tr><td class="py-3 pr-4"><code>status=connected</code></td><td>{id ? 'Session aktif dan binding account tersedia.' : 'The session is active and an account binding is available.'}</td></tr><tr><td class="py-3 pr-4"><code>status=disconnected</code></td><td>{id ? 'Tidak ada socket aktif; lihat audit/reconnect/pairing.' : 'No active socket; inspect audit/reconnect/pairing.'}</td></tr><tr><td class="py-3 pr-4"><code>accountHealth.availability</code></td><td><code>unavailable | checking | available</code></td></tr><tr><td class="py-3 pr-4"><code>accountHealth.unavailableReason</code></td><td><code>not_connected | session_invalid | fetch_failed</code></td></tr></tbody></table></div>
  <p class="text-sm text-[#71717a] mb-8">{id ? 'Reachout Time-lock dan New Chat Cap adalah sinyal WhatsApp/Baileys. Gunakan sebagai informasi defensif, bukan indikator bahwa account pasti aman dari restriction.' : 'Reachout Time-lock and New Chat Cap are WhatsApp/Baileys signals. Treat them as defensive information, not proof that an account is safe from restrictions.'}</p>

  <h2 class="text-xl font-semibold text-[#fafafa] mb-3">Audit API</h2>
  <p class="text-sm text-[#a1a1aa] leading-relaxed mb-4">{id ? 'Wago menyimpan structured audit event dari source wago dan baileys di SQLite. Baileys adapter membatasi metadata ke nilai primitif yang aman, masking identifier, dan menolak raw protocol payload.' : 'Wago stores structured audit events from wago and baileys sources in SQLite. The Baileys adapter limits metadata to safe primitive values, masks identifiers, and rejects raw protocol payloads.'}</p>
  <CodeBlock label="cURL" code={`curl "$WAGO_URL/activity?source=baileys&category=connection&level=warning&limit=50" \\\n  -H "Authorization: Bearer $WAGO_API_KEY"`} />
  <div class="overflow-x-auto mb-5"><table class="w-full text-sm"><tbody class="divide-y divide-[#1a1a1a] text-[#a1a1aa]"><tr><td class="py-3 pr-5"><code>source</code></td><td><code>wago | baileys</code></td></tr><tr><td class="py-3 pr-5"><code>category</code></td><td><code>system | security | connection | recipient | messaging</code></td></tr><tr><td class="py-3 pr-5"><code>level</code></td><td><code>info | success | warning | error</code></td></tr><tr><td class="py-3 pr-5"><code>q</code></td><td>{id ? 'Search pada code, title, description.' : 'Search code, title, and description.'}</td></tr><tr><td class="py-3 pr-5"><code>before</code></td><td>{id ? 'Cursor pagination dari nextCursor.' : 'Pagination cursor from nextCursor.'}</td></tr><tr><td class="py-3 pr-5"><code>limit</code></td><td>{id ? 'Default 100; clamp 1..200.' : 'Default 100; clamped to 1..200.'}</td></tr></tbody></table></div>
  <Callout title="Bounded retention">{id ? 'SQLite mempertahankan 2.000 audit event terbaru. Ini adalah operational evidence yang dibatasi, bukan message history atau raw protocol capture.' : 'SQLite retains the newest 2,000 audit events. This is bounded operational evidence, not message history or a raw protocol capture.'}</Callout>

  <h2 class="text-xl font-semibold text-[#fafafa] mt-9 mb-3">Logs</h2>
  <CodeBlock label="shell" code={`docker compose logs -f wago\ndocker compose logs --tail=200 wago`} />
  <p class="text-sm text-[#a1a1aa] mb-8">{id ? 'Runtime menggunakan structured logging dan redaction. Tetap jangan mempublikasikan raw production logs, database, atau auth directory.' : 'The runtime uses structured logging and redaction. Still do not publish raw production logs, the database, or the auth directory.'}</p>

  <h2 class="text-xl font-semibold text-[#fafafa] mb-3">{id ? 'Pair vs rebind' : 'Pair vs rebind'}</h2>
  <div class="grid sm:grid-cols-2 gap-4 mb-5"><div class="border border-[#262626] rounded-lg p-5"><code class="text-[#fafafa]">POST /whatsapp/pair</code><p class="text-sm text-[#71717a] mt-2">{id ? 'Mulai pairing untuk gateway unbound. Binding existing tidak diganti.' : 'Starts pairing for an unbound gateway. Existing binding is preserved.'}</p></div><div class="border border-[#262626] rounded-lg p-5"><code class="text-[#fafafa]">POST /whatsapp/rebind</code><p class="text-sm text-[#71717a] mt-2">{id ? 'Menghapus auth/binding lama lalu memulai pairing akun baru.' : 'Clears previous auth/binding and starts pairing a replacement account.'}</p></div></div>
  <Callout title={id ? 'Rebind bersifat destruktif terhadap session lama' : 'Rebind is destructive to the old session'} tone="warning">{id ? 'Gunakan rebind hanya saat benar-benar ingin mengganti account atau memulihkan session. Reconnect normal seharusnya ditangani lifecycle Wago.' : 'Use rebind only when intentionally replacing the account or recovering a session. Normal reconnects should be handled by the Wago lifecycle.'}</Callout>

  <h2 class="text-xl font-semibold text-[#fafafa] mt-9 mb-3">{id ? 'Persistence saat restart' : 'Persistence across restarts'}</h2>
  <div class="grid sm:grid-cols-2 gap-4 mb-8"><div class="border border-[#262626] rounded-lg p-5"><h3 class="text-sm font-semibold text-[#fafafa]">Durable</h3><ul class="list-disc pl-5 mt-3 text-sm text-[#71717a] space-y-1.5"><li><code>/app/data/wago.db</code></li><li>Gateway settings + API-key hash</li><li>WhatsApp binding</li><li>Recipient policy + outbound safety state</li><li>Audit events</li><li><code>/app/data/auth/</code></li></ul></div><div class="border border-[#262626] rounded-lg p-5"><h3 class="text-sm font-semibold text-[#fafafa]">Transient</h3><ul class="list-disc pl-5 mt-3 text-sm text-[#71717a] space-y-1.5"><li>Current QR/connection/reconnect state</li><li>Account-health cache</li><li>Recent-message cache</li><li>Message status cache</li></ul></div></div>

  <h2 class="text-xl font-semibold text-[#fafafa] mb-3">{id ? 'Backup /app/data' : 'Back up /app/data'}</h2>
  <p class="text-sm text-[#a1a1aa] mb-4">{id ? 'Stop service saat membuat backup agar snapshot SQLite/auth konsisten.' : 'Stop the service while taking a backup so the SQLite/auth snapshot is consistent.'}</p>
  <CodeBlock label="shell" code={`docker compose stop wago\nVOLUME=$(docker inspect "$(docker compose ps -aq wago)" --format '{{range .Mounts}}{{if eq .Destination "/app/data"}}{{.Name}}{{end}}{{end}}')\nmkdir -p backups\ndocker run --rm \\\n  -v "$VOLUME:/data:ro" \\\n  -v "$PWD/backups:/backup" \\\n  alpine:3.22 tar -C /data -czf /backup/wago-data.tgz .\nchmod 600 backups/wago-data.tgz\ndocker compose start wago`} />
  <Callout title={id ? 'Backup berisi credential sensitif' : 'Backups contain sensitive credentials'} tone="warning">{id ? 'Jangan upload /app/data, wago.db, WAL/SHM, atau auth files ke repository, public artifact, issue, atau support ticket.' : 'Never upload /app/data, wago.db, WAL/SHM, or auth files to a repository, public artifact, issue, or support ticket.'}</Callout>

  <h2 class="text-xl font-semibold text-[#fafafa] mt-10 mb-4">Troubleshooting</h2>
  <div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr class="border-b border-[#262626] text-[#71717a]"><th class="py-2.5 pr-4 text-left">{id ? 'Gejala' : 'Symptom'}</th><th class="py-2.5 text-left">{id ? 'Periksa' : 'Check'}</th></tr></thead><tbody class="divide-y divide-[#1a1a1a] text-[#a1a1aa]"><tr><td class="py-3 pr-4 text-[#fafafa]">401 UNAUTHORIZED</td><td>{id ? 'Bearer API key atau dashboard auth cookie.' : 'Bearer API key or dashboard auth cookie.'}</td></tr><tr><td class="py-3 pr-4 text-[#fafafa]">403 WEB_BOOTSTRAP_DISABLED</td><td>{id ? 'First-run web bootstrap dinonaktifkan untuk gateway tanpa credential.' : 'First-run web bootstrap is disabled for an uncredentialed gateway.'}</td></tr><tr><td class="py-3 pr-4 text-[#fafafa]">403 INVALID_SETUP_ORIGIN</td><td>{id ? 'Bootstrap production tidak berasal dari CORS_ORIGIN.' : 'Production bootstrap did not originate from CORS_ORIGIN.'}</td></tr><tr><td class="py-3 pr-4 text-[#fafafa]">403 RECIPIENT_NOT_ALLOWED</td><td>{id ? 'Allow hanya setelah permission nyata tersedia.' : 'Allow only after real permission exists.'}</td></tr><tr><td class="py-3 pr-4 text-[#fafafa]">403 RECIPIENT_OPTED_OUT</td><td>{id ? 'Jangan bypass opt-out.' : 'Do not bypass opt-out.'}</td></tr><tr><td class="py-3 pr-4 text-[#fafafa]">409 DUPLICATE_MESSAGE</td><td>{id ? 'Gunakan key baru hanya untuk pesan logis baru.' : 'Use a new key only for a new logical message.'}</td></tr><tr><td class="py-3 pr-4 text-[#fafafa]">429 *_RATE_LIMITED</td><td>{id ? 'Kurangi burst dan tunggu policy window.' : 'Reduce burst traffic and wait for the policy window.'}</td></tr><tr><td class="py-3 pr-4 text-[#fafafa]">429 REACHOUT_RESTRICTED</td><td>{id ? 'Jangan retry agresif; cek account health dan audit.' : 'Do not retry aggressively; inspect account health and audit.'}</td></tr><tr><td class="py-3 pr-4 text-[#fafafa]">503 WHATSAPP_NOT_CONNECTED</td><td>{id ? 'Cek /whatsapp/status, pairing/reconnect, dan audit connection.' : 'Check /whatsapp/status, pairing/reconnect, and connection audit events.'}</td></tr><tr><td class="py-3 pr-4 text-[#fafafa]">400 INVALID_AUDIT_CURSOR</td><td>{id ? 'Gunakan nextCursor persis dari response sebelumnya.' : 'Use the exact nextCursor from the previous response.'}</td></tr><tr><td class="py-3 pr-4 text-[#fafafa]">{id ? 'Live API Explorer kena CORS' : 'Live API Explorer hits CORS'}</td><td>{id ? 'Browser hanya dapat call origin yang diizinkan CORS_ORIGIN Wago; docs tidak melakukan proxy/bypass.' : 'The browser can only call an origin allowed by Wago CORS_ORIGIN; the docs do not proxy or bypass CORS.'}</td></tr></tbody></table></div>
</DocsLayout>
