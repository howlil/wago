---
import DocsLayout from '../../layouts/DocsLayout.astro';
import PageHeader from './PageHeader.astro';
import Callout from './Callout.astro';
import CodeBlock from './CodeBlock.astro';

interface Props { lang: 'en' | 'id' }
const { lang } = Astro.props;
const id = lang === 'id';
---

<DocsLayout title={id ? 'Memulai' : 'Getting Started'}>
  <PageHeader
    eyebrow="Quick start"
    title={id ? 'Dari container sampai pesan pertama' : 'From container to first message'}
    description={id ? 'Jalur production paling pendek menggunakan image GHCR resmi proyek dan hanya dua konfigurasi.' : 'The shortest production path using the project GHCR image and only two settings.'}
  />

  <h2 class="text-xl font-semibold text-[#fafafa] mb-3">1. {id ? 'Prasyarat' : 'Prerequisites'}</h2>
  <ul class="list-disc pl-5 text-sm text-[#a1a1aa] space-y-2 mb-8">
    <li>Docker Engine + Docker Compose v2.</li>
    <li>{id ? 'Satu nomor WhatsApp yang dapat membuka Linked devices.' : 'One WhatsApp account that can access Linked devices.'}</li>
    <li>{id ? 'HTTPS reverse proxy jika service diekspos melalui internet.' : 'An HTTPS reverse proxy when exposing the service to the internet.'}</li>
  </ul>

  <h2 class="text-xl font-semibold text-[#fafafa] mb-3">2. {id ? 'Siapkan dua nilai' : 'Prepare two values'}</h2>
  <CodeBlock label="shell" code={`git clone https://github.com/howlil/wago-simple.git\ncd wago-simple\ncp .env.production.example .env\nopenssl rand -hex 32`} />
  <CodeBlock label=".env" code={`API_KEY=replace-with-a-long-random-secret\nCORS_ORIGIN=https://wago.example.com`} />
  <Callout title={id ? 'Itu saja' : 'That is all'}>
    {id ? 'Port, data path, cookie security, logging, bootstrap mode, country code, dan runtime defaults lain tidak perlu dikonfigurasi.' : 'Port, data paths, cookie security, logging, bootstrap mode, country code, and other runtime defaults do not need configuration.'}
  </Callout>

  <h2 class="text-xl font-semibold text-[#fafafa] mt-9 mb-3">3. {id ? 'Jalankan service' : 'Start the service'}</h2>
  <CodeBlock label="shell" code={`docker compose pull\ndocker compose up -d\ndocker compose ps\ncurl http://127.0.0.1:3000/health`} />
  <p class="text-sm text-[#a1a1aa] mb-8">{id ? 'Compose selalu bind ke 127.0.0.1:3000. Gunakan reverse proxy/PaaS router untuk akses publik.' : 'Compose always binds to 127.0.0.1:3000. Use a reverse proxy or PaaS router for public access.'}</p>

  <h2 class="text-xl font-semibold text-[#fafafa] mb-3">4. Pair WhatsApp</h2>
  <ol class="list-decimal pl-5 text-sm text-[#a1a1aa] space-y-2 mb-8">
    <li>{id ? 'Buka dashboard Wago pada CORS_ORIGIN yang dikonfigurasi.' : 'Open the Wago dashboard at the configured CORS_ORIGIN.'}</li>
    <li>{id ? 'Masukkan API key.' : 'Enter the API key.'}</li>
    <li>{id ? 'Buka WhatsApp → Linked devices → Link a device.' : 'Open WhatsApp → Linked devices → Link a device.'}</li>
    <li>{id ? 'Scan QR yang ditampilkan dashboard.' : 'Scan the QR shown by the dashboard.'}</li>
  </ol>

  <h2 class="text-xl font-semibold text-[#fafafa] mb-3">5. {id ? 'Izinkan recipient' : 'Allow a recipient'}</h2>
  <CodeBlock label="cURL" code={`export WAGO_URL="https://wago.example.com"\nexport WAGO_API_KEY="your-api-key"\n\ncurl -X POST "$WAGO_URL/recipients/allow" \\\n  -H "Authorization: Bearer $WAGO_API_KEY" \\\n  -H "Content-Type: application/json" \\\n  -d '{"phone":"6281234567890","label":"Demo recipient"}'`} />

  <h2 class="text-xl font-semibold text-[#fafafa] mt-9 mb-3">6. {id ? 'Kirim pesan' : 'Send a message'}</h2>
  <CodeBlock label="cURL" code={`curl -X POST "$WAGO_URL/messages/send" \\\n  -H "Authorization: Bearer $WAGO_API_KEY" \\\n  -H "Content-Type: application/json" \\\n  -H "Idempotency-Key: demo-001" \\\n  -d '{"to":"6281234567890","text":"Hello from Wago"}'`} />
  <Callout title={id ? 'Arti HTTP 202' : 'What HTTP 202 means'} tone="warning">
    {id ? 'Response 202/pending berarti permintaan outbound diterima oleh layer Wago/Baileys. Ini bukan bukti pesan sudah delivered atau read.' : 'A 202/pending response means the outbound request was accepted by the Wago/Baileys layer. It is not proof that the message was delivered or read.'}
  </Callout>

  <h2 class="text-xl font-semibold text-[#fafafa] mt-9 mb-3">7. {id ? 'Cek status sementara' : 'Check retained status'}</h2>
  <CodeBlock label="cURL" code={`curl "$WAGO_URL/messages/<message-id>/status" \\\n  -H "Authorization: Bearer $WAGO_API_KEY"`} />
  <p class="text-sm text-[#71717a]">{id ? 'Status pesan disimpan di memory selama sekitar satu jam dan hilang saat proses restart.' : 'Message status is retained in memory for about one hour and is lost when the process restarts.'}</p>
</DocsLayout>
