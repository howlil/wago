---
import DocsLayout from '../../layouts/DocsLayout.astro';
import PageHeader from './PageHeader.astro';
import Callout from './Callout.astro';
import CodeBlock from './CodeBlock.astro';
interface Props { lang: 'en' | 'id' }
const { lang } = Astro.props;
const id = lang === 'id';
---

<DocsLayout title={id ? 'Konfigurasi' : 'Configuration'}>
  <PageHeader
    eyebrow="Runtime configuration"
    title={id ? 'Human auth dan machine auth dipisahkan' : 'Separate human and machine authentication'}
    description={id ? 'Dashboard memakai WAGO_ADMIN_PASSWORD dan HttpOnly session. API key hanya credential machine untuk server-to-server integration.' : 'The dashboard uses WAGO_ADMIN_PASSWORD and an HttpOnly session. API keys are machine credentials only for server-to-server integrations.'}
  />

  <Callout title={id ? 'Satu model auth' : 'One authentication model'} tone="warning">
    {id ? 'Machine API key tidak dapat dipakai untuk login dashboard. Production first-run selalu dimulai dari admin password.' : 'A machine API key cannot be used to sign in to the dashboard. Production first-run always starts from the admin password.'}
  </Callout>

  <h2 class="text-xl font-semibold text-[#fafafa] mt-9 mb-4">Environment variables</h2>
  <div class="overflow-x-auto mb-8">
    <table class="w-full text-sm text-left">
      <thead><tr class="border-b border-[#262626] text-[#71717a]"><th class="py-2.5 pr-4">Variable</th><th class="py-2.5 pr-4">{id ? 'Wajib' : 'Required'}</th><th class="py-2.5">{id ? 'Keterangan' : 'Description'}</th></tr></thead>
      <tbody class="divide-y divide-[#1a1a1a] text-[#a1a1aa]">
        <tr><td class="py-3 pr-4 text-[#fafafa]"><code>WAGO_ADMIN_PASSWORD</code></td><td class="py-3 pr-4">Production</td><td class="py-3">{id ? 'Password operator dashboard. Minimum 12 byte; tidak dipersistenkan oleh Wago.' : 'Dashboard operator password. Minimum 12 bytes; Wago does not persist it.'}</td></tr>
        <tr><td class="py-3 pr-4 text-[#fafafa]"><code>API_KEY</code></td><td class="py-3 pr-4">{id ? 'Opsional' : 'Optional'}</td><td class="py-3">{id ? 'Machine Bearer secret yang dikelola deployment. Jika tidak ada, Wago membuat generated key saat pairing pertama.' : 'Deployment-managed machine Bearer secret. If absent, Wago generates one during first pairing.'}</td></tr>
        <tr><td class="py-3 pr-4 text-[#fafafa]"><code>TRUST_PROXY</code></td><td class="py-3 pr-4">{id ? 'Opsional' : 'Optional'}</td><td class="py-3">{id ? 'Aktifkan hanya bila reverse proxy tepercaya harus menentukan request metadata.' : 'Enable only when a trusted reverse proxy must define request metadata.'}</td></tr>
        <tr><td class="py-3 pr-4 text-[#fafafa]"><code>DEFAULT_COUNTRY_CODE</code></td><td class="py-3 pr-4">{id ? 'Opsional' : 'Optional'}</td><td class="py-3">{id ? 'Default 62 untuk normalisasi nomor lokal.' : 'Defaults to 62 for local-number normalization.'}</td></tr>
      </tbody>
    </table>
  </div>

  <h2 class="text-xl font-semibold text-[#fafafa] mb-3">{id ? 'Default flow' : 'Default flow'}</h2>
  <CodeBlock label="shell" code={`export WAGO_ADMIN_PASSWORD="$(openssl rand -base64 32)"\ndocker compose up -d`} />
  <p class="text-sm text-[#a1a1aa] leading-relaxed mb-8">{id ? 'Sign in ke dashboard, klik Pair WhatsApp, lalu simpan generated machine API key yang ditampilkan sekali. Backend menyimpan hanya hash key tersebut.' : 'Sign in to the dashboard, click Pair WhatsApp, then save the generated machine API key shown once. The backend stores only its hash.'}</p>

  <h2 class="text-xl font-semibold text-[#fafafa] mb-3">{id ? 'Pre-provisioned machine key' : 'Pre-provisioned machine key'}</h2>
  <CodeBlock label="shell" code={`export WAGO_ADMIN_PASSWORD="$(openssl rand -base64 32)"\nexport API_KEY="$(openssl rand -hex 32)"\ndocker compose up -d`} />
  <p class="text-sm text-[#a1a1aa] leading-relaxed mb-8">{id ? 'Environment API key dirotasi melalui secret manager deployment, bukan dashboard. Admin password tetap credential manusia.' : 'An environment API key is rotated through the deployment secret manager, not the dashboard. The admin password remains the human credential.'}</p>

  <h2 class="text-xl font-semibold text-[#fafafa] mb-3">Webhook</h2>
  <p class="text-sm text-[#a1a1aa] leading-relaxed mb-4">{id ? 'Webhook callback URL dan signing-secret lifecycle dikonfigurasi dari Settings dan dipersistenkan di SQLite. Delivery bersifat at-least-once.' : 'Webhook callback URL and signing-secret lifecycle are configured from Settings and persisted in SQLite. Delivery is at least once.'}</p>
  <Callout title={id ? 'External integration tetap server-to-server' : 'External integrations remain server-to-server'}>{id ? 'Jangan tanam admin password, Bearer API key, atau webhook secret pada public browser bundle.' : 'Do not embed the admin password, Bearer API key, or webhook secret in a public browser bundle.'}</Callout>
</DocsLayout>
