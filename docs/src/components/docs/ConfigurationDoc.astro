---
import DocsLayout from '../../layouts/DocsLayout.astro';
import PageHeader from './PageHeader.astro';
import Callout from './Callout.astro';
import CodeBlock from './CodeBlock.astro';

interface Props { lang: 'en' | 'id' }
const { lang } = Astro.props;
const id = lang === 'id';

const internalDefaults = [
  ['HTTP', '0.0.0.0:3000', id ? 'Alamat aplikasi di dalam container.' : 'Application address inside the container.'],
  ['Host publish', '127.0.0.1:3000', id ? 'Compose publish hanya ke loopback host.' : 'Compose publishes only to host loopback.'],
  ['Data', '/app/data', id ? 'Root persistent volume; production menolak storage ephemeral.' : 'Persistent volume root; production rejects ephemeral storage.'],
  ['Database', '/app/data/wago.db', id ? 'SQLite durable state dan webhook outbox.' : 'SQLite durable state and webhook outbox.'],
  ['WhatsApp auth', '/app/data/auth', id ? 'Baileys multi-file auth state.' : 'Baileys multi-file auth state.'],
  ['Active instance', '1', id ? 'Satu owner untuk satu persistent volume/account.' : 'One owner for one persistent volume/account.'],
  ['Browser session', '30 days', id ? 'Opaque HttpOnly cookie; hash saja di SQLite.' : 'Opaque HttpOnly cookie; hash only in SQLite.'],
  ['Request body', '32kb', id ? 'Batas JSON body.' : 'JSON body limit.'],
  ['Webhook timeout', '5s', id ? 'Timeout tiap HTTP callback attempt.' : 'Timeout for each callback HTTP attempt.'],
  ['Webhook retry horizon', '24h', id ? 'At-least-once durable retry.' : 'At-least-once durable retry.'],
  ['Webhook test', '5/min', id ? 'Dashboard-only test callback rate limit.' : 'Dashboard-only test callback rate limit.'],
];
---

<DocsLayout title={id ? 'Konfigurasi' : 'Configuration'}>
  <PageHeader
    eyebrow="Runtime configuration"
    title={id ? 'First run tanpa .env' : 'First run without .env'}
    description={id ? 'Akun admin dibuat langsung dari dashboard dan password disimpan hanya sebagai salted hash di SQLite. Machine API key tetap credential terpisah untuk integrasi server-to-server.' : 'The admin account is created directly from the dashboard and the password is stored only as a salted hash in SQLite. The machine API key remains a separate credential for server-to-server integrations.'}
  />

  <Callout title={id ? 'API key bukan password dashboard' : 'The API key is not the dashboard password'} tone="warning">
    {id ? 'Operator manusia membuat dan memakai admin password melalui dashboard. External service memakai Authorization: Bearer <API_KEY>. Machine API key tidak diterima sebagai credential login dashboard.' : 'Human operators create and use an admin password through the dashboard. External services use Authorization: Bearer <API_KEY>. Machine API keys are not accepted as dashboard login credentials.'}
  </Callout>

  <h2 class="text-xl font-semibold text-[#fafafa] mt-9 mb-3">{id ? 'Default — tidak perlu environment credential' : 'Default — no environment credential required'}</h2>
  <CodeBlock label="shell" code={`docker compose pull\ndocker compose up -d`} />
  <p class="text-sm text-[#a1a1aa] leading-relaxed mb-4">{id ? 'Pada fresh instance, Gateway access menampilkan Create account. Masukkan admin password minimum 12 byte. Wago membuat salted scrypt hash di SQLite, tidak menyimpan raw password, lalu membuat HttpOnly browser session.' : 'On a fresh instance, Gateway access shows Create account. Enter an admin password of at least 12 bytes. Wago writes a salted scrypt hash to SQLite, never stores the raw password, then creates an HttpOnly browser session.'}</p>
  <p class="text-sm text-[#71717a] mb-4">{id ? 'Pada Pair WhatsApp pertama, browser session yang sudah autentik mengizinkan Wago membuat machine API key. Raw key ditampilkan sekali untuk disimpan di application/secret manager; server menyimpan hanya SHA-256 hash untuk generated key.' : 'On the first Pair WhatsApp action, the authenticated browser session allows Wago to create the machine API key. The raw key is shown once for storage in your application/secret manager; the server stores only the SHA-256 hash for a generated key.'}</p>
  <Callout title={id ? 'Fresh instance adalah first-browser ownership' : 'Fresh instances use first-browser ownership'} tone="warning">{id ? 'Selesaikan Create account sebelum dashboard yang belum ter-setup dapat dijangkau jaringan tidak terpercaya. Same-origin mencegah cross-site claim, tetapi tidak membedakan dua pengguna yang sama-sama dapat membuka origin fresh Wago.' : 'Complete Create account before an uninitialized dashboard is reachable from an untrusted network. Same-origin validation prevents cross-site claiming, but it cannot distinguish two users who can both directly reach a fresh Wago origin.'}</Callout>

  <h2 class="text-xl font-semibold text-[#fafafa] mt-9 mb-4">{id ? 'Environment variable opsional' : 'Optional environment variable'}</h2>
  <div class="overflow-x-auto mb-4">
    <table class="w-full text-sm text-left">
      <thead><tr class="border-b border-[#262626] text-[#71717a]"><th class="py-2.5 pr-4">Variable</th><th class="py-2.5 pr-4">{id ? 'Wajib' : 'Required'}</th><th class="py-2.5">{id ? 'Keterangan' : 'Description'}</th></tr></thead>
      <tbody class="divide-y divide-[#1a1a1a] text-[#a1a1aa]">
        <tr><td class="py-3 pr-4 text-[#fafafa]"><code>API_KEY</code></td><td class="py-3 pr-4">{id ? 'Tidak' : 'No'}</td><td class="py-3">{id ? 'Override machine Bearer secret untuk deployment yang memang ingin secret manager memiliki credential. Bila tidak ada, Wago membuat generated API key dari dashboard.' : 'Machine Bearer secret override for deployments that explicitly want a secret manager to own the credential. When absent, Wago creates a generated API key from the dashboard.'}</td></tr>
      </tbody>
    </table>
  </div>

  <h2 class="text-xl font-semibold text-[#fafafa] mb-3">{id ? 'Opsional — pre-provisioned machine API key' : 'Optional — pre-provisioned machine API key'}</h2>
  <CodeBlock label="shell" code={`API_KEY="$(openssl rand -hex 32)" docker compose up -d`} />
  <p class="text-sm text-[#a1a1aa] leading-relaxed mb-8">{id ? 'Gunakan hanya bila secret manager/deployment platform mengelola machine credential. API key environment tidak dipersistenkan ke SQLite dan tidak dapat dirotasi dari dashboard. Human dashboard access tetap dibuat di Wago melalui first-run admin setup.' : 'Use this only when a secret manager or deployment platform owns the machine credential. Environment API keys are not persisted into SQLite and cannot be rotated from the dashboard. Human dashboard access is still created inside Wago through first-run admin setup.'}</p>

  <h2 class="text-xl font-semibold text-[#fafafa] mb-3">Browser sessions & API-key rotation</h2>
  <p class="text-sm text-[#a1a1aa] leading-relaxed mb-4">{id ? 'Dashboard memverifikasi admin password terhadap salted hash di SQLite lalu mengeluarkan opaque HttpOnly browser session. Rotasi generated machine API key mencabut semua browser session lain tetapi mempertahankan browser yang melakukan rotasi agar operator dapat menyimpan key baru. WhatsApp auth tidak berubah.' : 'The dashboard verifies the admin password against the salted hash in SQLite and issues an opaque HttpOnly browser session. Rotating a generated machine API key revokes every other browser session while preserving the browser performing the rotation so the operator can save the new key. WhatsApp auth is unchanged.'}</p>
  <p class="text-sm text-[#71717a] mb-8">{id ? 'Raw admin password tidak dipersistenkan. Raw generated API key juga tidak dipersistenkan; hanya hash yang disimpan setelah key ditampilkan sekali.' : 'The raw admin password is not persisted. The raw generated API key is also not persisted; only its hash remains after the key is shown once.'}</p>

  <h2 class="text-xl font-semibold text-[#fafafa] mt-9 mb-3">Delivery webhook</h2>
  <p class="text-sm text-[#a1a1aa] leading-relaxed mb-4">{id ? 'Konfigurasi dilakukan dari Settings → Webhook integration. Wago menyimpan callback URL dan raw signing secret di private SQLite state karena nilai secret asli diperlukan untuk HMAC.' : 'Configuration is managed from Settings → Webhook integration. Wago stores the callback URL and raw signing secret in private SQLite state because the original secret is required for HMAC.'}</p>
  <p class="text-sm text-[#a1a1aa] leading-relaxed mb-4">{id ? 'Setelah konfigurasi enabled disimpan, Send test webhook membuat event wago.test tanpa message/recipient data. Test memakai signing, timeout, durable queue, retry, dan delivery history production yang sama sehingga hasilnya memverifikasi jalur callback sebenarnya.' : 'After an enabled configuration is saved, Send test webhook creates a wago.test event without message or recipient data. The test uses the same production signing, timeout, durable queue, retry, and delivery history so the result verifies the real callback path.'}</p>
  <p class="text-sm text-[#a1a1aa] leading-relaxed mb-4">{id ? 'Test webhook hanya tersedia untuk browser session dashboard, memakai same-origin guard di production, dan dibatasi 5 request per menit. Bearer API key tidak dapat memanggil test endpoint.' : 'Webhook tests are available only to authenticated dashboard browser sessions, enforce same-origin in production, and are limited to 5 requests per minute. Bearer API keys cannot call the test endpoint.'}</p>
  <p class="text-sm text-[#a1a1aa] leading-relaxed mb-4">{id ? 'Callback membawa Webhook-Id, Webhook-Timestamp, Webhook-Signature, X-Wago-Event, dan X-Wago-Delivery. Consumer harus verifikasi HMAC pada raw body, batasi umur timestamp, lalu deduplicate dengan Webhook-Id.' : 'Callbacks include Webhook-Id, Webhook-Timestamp, Webhook-Signature, X-Wago-Event, and X-Wago-Delivery. Consumers must verify HMAC against the raw body, enforce timestamp age, then deduplicate by Webhook-Id.'}</p>
  <p class="text-sm text-[#a1a1aa] leading-relaxed mb-4">{id ? 'Delivery bersifat at-least-once. Timeout/network/408/429/5xx diretry durably sampai 24 jam. Retry dan manual redelivery mempertahankan delivery ID yang sama.' : 'Delivery is at least once. Timeout/network/408/429/5xx failures are retried durably for up to 24 hours. Retries and manual redelivery preserve the same delivery ID.'}</p>
  <Callout title={id ? 'server accepted bukan delivered/read' : 'server accepted is not delivered/read'} tone="warning">{id ? 'message.server_accepted berarti setidaknya server acknowledgement dari WhatsApp. Ini bukan bukti device recipient delivered atau read.' : 'message.server_accepted means at least a WhatsApp server acknowledgement. It is not proof of recipient-device delivery or read status.'}</Callout>

  <h2 class="text-xl font-semibold text-[#fafafa] mt-9 mb-3">{id ? 'Origin dan browser security' : 'Origin and browser security'}</h2>
  <p class="text-sm text-[#a1a1aa] leading-relaxed mb-4">{id ? 'Wago tidak memiliki operator CORS allowlist. Production admin setup, dashboard sign-in, dan bootstrap machine API key memerlukan same-origin. State-changing request dengan cookie auth menolak mismatched Origin.' : 'Wago does not expose an operator CORS allowlist. Production admin setup, dashboard sign-in, and machine API-key bootstrap require same-origin. State-changing cookie-authenticated requests reject a mismatched Origin.'}</p>
  <Callout title={id ? 'External integration tetap server-to-server' : 'External integrations remain server-to-server'}>{id ? 'Jangan tanam admin password, Bearer API key, atau webhook signing secret pada public browser bundle.' : 'Do not embed the admin password, Bearer API keys, or webhook signing secrets in a public browser bundle.'}</Callout>

  <h2 class="text-xl font-semibold text-[#fafafa] mt-9 mb-4">{id ? 'Default internal' : 'Internal defaults'}</h2>
  <div class="overflow-x-auto"><table class="w-full text-sm text-left"><thead><tr class="border-b border-[#262626] text-[#71717a]"><th class="py-2.5 pr-4">Setting</th><th class="py-2.5 pr-4">Default</th><th class="py-2.5">{id ? 'Keterangan' : 'Description'}</th></tr></thead><tbody class="divide-y divide-[#1a1a1a] text-[#a1a1aa]">{internalDefaults.map(row => <tr><td class="py-3 pr-4 text-[#fafafa]">{row[0]}</td><td class="py-3 pr-4 text-[#71717a]"><code>{row[1]}</code></td><td class="py-3">{row[2]}</td></tr>)}</tbody></table></div>

  <h2 class="text-xl font-semibold text-[#fafafa] mt-9 mb-3">Outbound limits</h2>
  <ul class="list-disc pl-5 text-sm text-[#a1a1aa] space-y-2 mb-4"><li>{id ? 'Account: 30 accepted send / 60 detik.' : 'Account: 30 accepted sends / 60 seconds.'}</li><li>{id ? 'Recipient: 5 accepted send / 60 detik.' : 'Recipient: 5 accepted sends / 60 seconds.'}</li><li>{id ? 'New chat: 10 recipient baru / jam.' : 'New chat: 10 new recipients / hour.'}</li><li>{id ? 'Webhook test: 5 request / menit untuk dashboard session.' : 'Webhook test: 5 requests/minute for dashboard sessions.'}</li><li>{id ? 'Manual webhook redelivery: 20 request / menit per source IP.' : 'Manual webhook redelivery: 20 requests/minute per source IP.'}</li></ul>
  <Callout title={id ? 'Guardrail lokal' : 'Local guardrails'} tone="warning">{id ? 'Angka tersebut adalah default defensif Wago, bukan threshold resmi WhatsApp atau jaminan anti-ban.' : 'These values are Wago defensive defaults, not official WhatsApp thresholds or an anti-ban guarantee.'}</Callout>
</DocsLayout>
