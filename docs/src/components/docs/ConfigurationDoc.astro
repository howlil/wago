---
import DocsLayout from '../../layouts/DocsLayout.astro';
import PageHeader from './PageHeader.astro';
import Callout from './Callout.astro';
import CodeBlock from './CodeBlock.astro';

interface Props { lang: 'en' | 'id' }
const { lang } = Astro.props;
const id = lang === 'id';

const internalDefaults = [
  ['HTTP', '0.0.0.0:3000', id ? 'Alamat aplikasi di dalam container.' : 'Application address inside the container.'],
  ['Host publish', '127.0.0.1:3000', id ? 'Compose publish hanya ke loopback host.' : 'Compose publishes only to host loopback.'],
  ['Data', '/app/data', id ? 'Root persistent volume; production menolak storage ephemeral.' : 'Persistent volume root; production rejects ephemeral storage.'],
  ['Database', '/app/data/wago.db', id ? 'SQLite durable state dan webhook outbox.' : 'SQLite durable state and webhook outbox.'],
  ['WhatsApp auth', '/app/data/auth', id ? 'Baileys multi-file auth state.' : 'Baileys multi-file auth state.'],
  ['Active instance', '1', id ? 'Satu owner untuk satu persistent volume/account.' : 'One owner for one persistent volume/account.'],
  ['Browser session', '30 days', id ? 'Opaque HttpOnly cookie; hash saja di SQLite.' : 'Opaque HttpOnly cookie; hash only in SQLite.'],
  ['Request body', '32kb', id ? 'Batas JSON body.' : 'JSON body limit.'],
  ['Webhook timeout', '5s', id ? 'Timeout tiap HTTP callback attempt.' : 'Timeout for each callback HTTP attempt.'],
  ['Webhook retry horizon', '24h', id ? 'At-least-once durable retry.' : 'At-least-once durable retry.'],
];
---

<DocsLayout title={id ? 'Konfigurasi' : 'Configuration'}>
  <PageHeader
    eyebrow="Runtime configuration"
    title={id ? 'Production configuration yang kecil tetapi fail-closed' : 'Small production configuration with fail-closed defaults'}
    description={id ? 'Fresh production harus memilih SETUP_TOKEN untuk bootstrap dashboard pertama atau API_KEY untuk pre-provisioning. Webhook utama tetap dikelola dari Settings dan dipersistenkan ke SQLite.' : 'Fresh production must choose SETUP_TOKEN for the first dashboard bootstrap or API_KEY for pre-provisioning. Primary webhook configuration remains managed from Settings and persisted in SQLite.'}
  />

  <Callout title={id ? 'Same-origin bukan bukti ownership' : 'Same-origin is not ownership proof'} tone="warning">
    {id ? 'Production tidak mengizinkan anonymous first-run bootstrap. SETUP_TOKEN minimal 32 byte diperlukan bila API_KEY belum diprovisikan. Token setup hanya dibaca dari environment dan tidak disimpan di SQLite atau browser storage.' : 'Production does not allow anonymous first-run bootstrap. A SETUP_TOKEN with at least 32 bytes is required when API_KEY is not pre-provisioned. The setup token is read only from the environment and is not stored in SQLite or browser storage.'}
  </Callout>

  <h2 class="text-xl font-semibold text-[#fafafa] mt-9 mb-4">Environment variables</h2>
  <div class="overflow-x-auto mb-4">
    <table class="w-full text-sm text-left">
      <thead><tr class="border-b border-[#262626] text-[#71717a]"><th class="py-2.5 pr-4">Variable</th><th class="py-2.5 pr-4">{id ? 'Wajib' : 'Required'}</th><th class="py-2.5">{id ? 'Keterangan' : 'Description'}</th></tr></thead>
      <tbody class="divide-y divide-[#1a1a1a] text-[#a1a1aa]">
        <tr><td class="py-3 pr-4 text-[#fafafa]"><code>SETUP_TOKEN</code></td><td class="py-3 pr-4">{id ? 'Fresh prod*' : 'Fresh prod*'}</td><td class="py-3">{id ? 'High-entropy secret minimal 32 byte untuk mengotorisasi first-run dashboard bootstrap. Tidak diperlukan bila API_KEY sudah ada.' : 'High-entropy secret of at least 32 bytes authorizing first-run dashboard bootstrap. Not required when API_KEY already exists.'}</td></tr>
        <tr><td class="py-3 pr-4 text-[#fafafa]"><code>API_KEY</code></td><td class="py-3 pr-4">{id ? 'Alternatif' : 'Alternative'}</td><td class="py-3">{id ? 'Bearer secret yang dikelola deployment. Bila ada, web bootstrap tidak digunakan dan rotasi dilakukan di deployment secret manager.' : 'Deployment-managed Bearer secret. When present, web bootstrap is not used and rotation belongs to the deployment secret manager.'}</td></tr>
        <tr><td class="py-3 pr-4 text-[#fafafa]"><code>WEBHOOK_URL</code></td><td class="py-3 pr-4">Legacy</td><td class="py-3">{id ? 'One-time compatibility import bila SQLite belum memiliki webhook settings.' : 'One-time compatibility import when SQLite has no webhook settings.'}</td></tr>
        <tr><td class="py-3 pr-4 text-[#fafafa]"><code>WEBHOOK_SECRET</code></td><td class="py-3 pr-4">Legacy</td><td class="py-3">{id ? 'Pasangan legacy WEBHOOK_URL. Flow baru membuat secret dari Settings.' : 'Legacy WEBHOOK_URL pair. New flows create the secret from Settings.'}</td></tr>
        <tr><td class="py-3 pr-4 text-[#fafafa]"><code>WEBHOOK_SECRET_PREVIOUS</code></td><td class="py-3 pr-4">Legacy</td><td class="py-3">{id ? 'Previous secret untuk import/migration lama.' : 'Previous secret for legacy import/migration.'}</td></tr>
      </tbody>
    </table>
  </div>
  <p class="text-xs text-[#71717a] leading-relaxed mb-10">* {id ? 'Fresh production yang belum memiliki generated credential hash di persistent SQLite.' : 'A fresh production gateway with no generated credential hash in persistent SQLite.'}</p>

  <h2 class="text-xl font-semibold text-[#fafafa] mb-3">Mode A — authorized first-run dashboard</h2>
  <CodeBlock label="shell" code={`export SETUP_TOKEN="$(openssl rand -hex 32)"\ndocker compose up -d`} />
  <p class="text-sm text-[#a1a1aa] leading-relaxed mb-4">{id ? 'Masukkan SETUP_TOKEN yang sama pada dashboard. Browser membuat kandidat wa_ random, POST /app/bootstrap memverifikasi same-origin + setup token, lalu backend menyimpan hanya SHA-256 hash generated API key di app_settings.' : 'Enter the same SETUP_TOKEN in the dashboard. The browser creates a random wa_ candidate, POST /app/bootstrap verifies same-origin plus the setup token, then the backend stores only the generated API-key SHA-256 hash in app_settings.'}</p>
  <p class="text-sm text-[#71717a] mb-9">{id ? 'Raw generated API key ditampilkan untuk disimpan operator tetapi tidak disimpan server atau browser storage.' : 'The raw generated API key is shown for operator storage but is not persisted by the server or browser storage.'}</p>

  <h2 class="text-xl font-semibold text-[#fafafa] mb-3">Mode B — pre-provisioned API key</h2>
  <CodeBlock label="shell" code={`export API_KEY="$(openssl rand -hex 32)"\nunset SETUP_TOKEN\ndocker compose up -d`} />
  <p class="text-sm text-[#a1a1aa] leading-relaxed mb-8">{id ? 'Gunakan mode ini bila secret manager/deployment platform mengelola credential machine. API key environment tidak dipersistenkan ke SQLite dan tidak dapat dirotasi dari dashboard.' : 'Use this mode when a secret manager or deployment platform owns the machine credential. Environment API keys are not persisted into SQLite and cannot be rotated from the dashboard.'}</p>

  <h2 class="text-xl font-semibold text-[#fafafa] mb-3">Browser sessions & API-key rotation</h2>
  <p class="text-sm text-[#a1a1aa] leading-relaxed mb-4">{id ? 'Dashboard menukar API key dengan opaque HttpOnly browser session. Rotasi generated API key mencabut semua browser session lain tetapi mempertahankan session browser yang melakukan rotasi agar operator dapat menyimpan key baru. WhatsApp auth tidak berubah.' : 'The dashboard exchanges the API key for an opaque HttpOnly browser session. Rotating a generated API key revokes every other browser session while preserving the browser that performs the rotation so the operator can save the new key. WhatsApp auth is unchanged.'}</p>
  <p class="text-sm text-[#71717a] mb-8">{id ? 'Sign out all mencabut semua browser session tanpa mengubah API key machine atau Baileys session.' : 'Sign out all revokes every browser session without changing the machine API key or Baileys session.'}</p>

  <h2 class="text-xl font-semibold text-[#fafafa] mt-9 mb-3">Delivery webhook</h2>
  <p class="text-sm text-[#a1a1aa] leading-relaxed mb-4">{id ? 'Konfigurasi utama dilakukan dari Settings → Webhook integration. Wago menyimpan callback URL dan raw signing secret di private SQLite state karena nilai secret asli diperlukan untuk HMAC.' : 'Primary configuration is managed from Settings → Webhook integration. Wago stores the callback URL and raw signing secret in private SQLite state because the original secret is required for HMAC.'}</p>
  <p class="text-sm text-[#a1a1aa] leading-relaxed mb-4">{id ? 'Callback membawa Webhook-Id, Webhook-Timestamp, Webhook-Signature, X-Wago-Event, dan X-Wago-Delivery. Consumer harus verifikasi HMAC pada raw body, batasi umur timestamp, lalu deduplicate dengan Webhook-Id.' : 'Callbacks include Webhook-Id, Webhook-Timestamp, Webhook-Signature, X-Wago-Event, and X-Wago-Delivery. Consumers must verify HMAC against the raw body, enforce timestamp age, then deduplicate by Webhook-Id.'}</p>
  <p class="text-sm text-[#a1a1aa] leading-relaxed mb-4">{id ? 'Delivery bersifat at-least-once. Timeout/network/408/429/5xx diretry durably sampai 24 jam. Crash setelah consumer memproses callback tetapi sebelum Wago menandai delivered dapat menghasilkan duplicate yang valid. Retry dan manual redelivery mempertahankan delivery ID yang sama.' : 'Delivery is at least once. Timeout/network/408/429/5xx failures are retried durably for up to 24 hours. A crash after the consumer processes a callback but before Wago records it as delivered can produce a valid duplicate. Retries and manual redelivery preserve the same delivery ID.'}</p>
  <Callout title={id ? 'server accepted bukan delivered/read' : 'server accepted is not delivered/read'} tone="warning">{id ? 'message.server_accepted berarti setidaknya server acknowledgement dari WhatsApp. Ini bukan bukti device recipient delivered atau read.' : 'message.server_accepted means at least a WhatsApp server acknowledgement. It is not proof of recipient-device delivery or read status.'}</Callout>

  <h2 class="text-xl font-semibold text-[#fafafa] mt-9 mb-3">{id ? 'Origin dan browser security' : 'Origin and browser security'}</h2>
  <p class="text-sm text-[#a1a1aa] leading-relaxed mb-4">{id ? 'Wago tidak memiliki operator CORS allowlist. Production bootstrap memerlukan HTTPS same-origin dan SETUP_TOKEN. State-changing request dengan cookie auth menolak mismatched Origin.' : 'Wago does not expose an operator CORS allowlist. Production bootstrap requires HTTPS same-origin plus SETUP_TOKEN. State-changing cookie-authenticated requests reject a mismatched Origin.'}</p>
  <Callout title={id ? 'External integration tetap server-to-server' : 'External integrations remain server-to-server'}>{id ? 'Bearer API key, SETUP_TOKEN, dan webhook signing secret tidak boleh ditanam pada public browser bundle.' : 'Do not embed Bearer API keys, SETUP_TOKEN, or webhook signing secrets in a public browser bundle.'}</Callout>

  <h2 class="text-xl font-semibold text-[#fafafa] mt-9 mb-4">{id ? 'Default internal' : 'Internal defaults'}</h2>
  <div class="overflow-x-auto"><table class="w-full text-sm text-left"><thead><tr class="border-b border-[#262626] text-[#71717a]"><th class="py-2.5 pr-4">Setting</th><th class="py-2.5 pr-4">Default</th><th class="py-2.5">{id ? 'Keterangan' : 'Description'}</th></tr></thead><tbody class="divide-y divide-[#1a1a1a] text-[#a1a1aa]">{internalDefaults.map(row => <tr><td class="py-3 pr-4 text-[#fafafa]">{row[0]}</td><td class="py-3 pr-4 text-[#71717a]"><code>{row[1]}</code></td><td class="py-3">{row[2]}</td></tr>)}</tbody></table></div>

  <h2 class="text-xl font-semibold text-[#fafafa] mt-9 mb-3">Outbound limits</h2>
  <ul class="list-disc pl-5 text-sm text-[#a1a1aa] space-y-2 mb-4"><li>{id ? 'Account: 30 accepted send / 60 detik.' : 'Account: 30 accepted sends / 60 seconds.'}</li><li>{id ? 'Recipient: 5 accepted send / 60 detik.' : 'Recipient: 5 accepted sends / 60 seconds.'}</li><li>{id ? 'New chat: 10 recipient baru / jam.' : 'New chat: 10 new recipients / hour.'}</li><li>{id ? 'Manual webhook redelivery: 20 request / menit per source IP.' : 'Manual webhook redelivery: 20 requests/minute per source IP.'}</li></ul>
  <Callout title={id ? 'Guardrail lokal' : 'Local guardrails'} tone="warning">{id ? 'Angka tersebut adalah default defensif Wago, bukan threshold resmi WhatsApp atau jaminan anti-ban.' : 'These values are Wago defensive defaults, not official WhatsApp thresholds or an anti-ban guarantee.'}</Callout>
</DocsLayout>
