---
import DocsLayout from '../../layouts/DocsLayout.astro';
import PageHeader from './PageHeader.astro';
import Callout from './Callout.astro';
import CodeBlock from './CodeBlock.astro';

interface Props { lang: 'en' | 'id' }
const { lang } = Astro.props;
const id = lang === 'id';

const internalDefaults = [
  ['HTTP', '0.0.0.0:3000', id ? 'Alamat aplikasi di dalam container.' : 'Application address inside the container.'],
  ['Host publish', '127.0.0.1:3000', id ? 'Compose publish hanya ke loopback host.' : 'Compose publishes only to host loopback.'],
  ['Data', '/app/data', id ? 'Root persistent volume.' : 'Persistent volume root.'],
  ['Database', '/app/data/wago.db', id ? 'SQLite durable application state dan webhook outbox.' : 'SQLite durable application state and webhook outbox.'],
  ['WhatsApp auth', '/app/data/auth', id ? 'Baileys multi-file auth state.' : 'Baileys multi-file auth state.'],
  ['Request body', '32kb', id ? 'Batas JSON body.' : 'JSON body limit.'],
  ['Country code', '62', id ? 'Normalisasi nomor lokal Indonesia.' : 'Indonesian local-number normalization.'],
  ['Logging', 'info (production)', id ? 'Structured logging dengan redaction.' : 'Structured logging with redaction.'],
  ['Web bootstrap', 'first run only', id ? 'Tersedia hanya sebelum API credential tersimpan.' : 'Available only before API credentials are persisted.'],
  ['Secure auth cookie', 'production', id ? 'HttpOnly cookie menggunakan Secure di production.' : 'The HttpOnly cookie uses Secure in production.'],
  ['Trust proxy', 'false', id ? 'Tidak diekspos sebagai operator setting.' : 'Not exposed as an operator setting.'],
  ['Webhook timeout', '5s', id ? 'Timeout tiap HTTP callback attempt.' : 'Timeout for each callback HTTP attempt.'],
  ['Webhook retry horizon', '24h', id ? 'Retry durable dengan backoff dan jitter; state bertahan setelah restart.' : 'Durable retry with backoff and jitter; state survives restarts.'],
  ['Webhook claim recovery', '60s', id ? 'Claim delivering yang stale dapat diambil worker lagi.' : 'Stale delivering claims can be reclaimed by the worker.'],
  ['WA version', 'live lookup + fallback', id ? 'Resolve versi WhatsApp Web saat socket baru dibuat; fallback ke default Baileys bila lookup gagal.' : 'Resolve the WhatsApp Web version before a new socket is created; fall back to the Baileys default when lookup fails.'],
];
---

<DocsLayout title={id ? 'Konfigurasi' : 'Configuration'}>
  <PageHeader
    eyebrow="Runtime configuration"
    title={id ? 'Production configuration yang sengaja minimal' : 'Intentionally small production configuration'}
    description={id ? 'Stock Docker Compose dapat dijalankan tanpa file environment. Sebagian besar runtime memakai default internal dan durable state di /app/data; API_KEY bersifat opsional, sedangkan webhook hanya aktif bila URL dan signing secret dikonfigurasi secara lengkap.' : 'The stock Docker Compose file runs without an environment file. Most runtime behavior uses fixed internal defaults and durable state under /app/data; API_KEY is optional, while webhooks are enabled only when their URL and signing secret are fully configured.'}
  />

  <Callout title={id ? 'Default: tidak perlu .env' : 'Default: no .env required'}>
    {id ? 'Untuk fresh deployment dengan stock Compose, buka dashboard melalui HTTPS dan gunakan first-run bootstrap. Credential generated disimpan sebagai hash di SQLite; raw key hanya diberikan ke browser/operator. Webhook tetap nonaktif bila variable webhook kosong.' : 'For a fresh deployment with stock Compose, open the dashboard over HTTPS and use first-run bootstrap. The generated credential is stored as a hash in SQLite; the raw key is only returned to the browser/operator. Webhooks remain disabled when webhook variables are empty.'}
  </Callout>

  <h2 class="text-xl font-semibold text-[#fafafa] mt-9 mb-4">Environment variables</h2>
  <div class="overflow-x-auto mb-10">
    <table class="w-full text-sm text-left">
      <thead><tr class="border-b border-[#262626] text-[#71717a]"><th class="py-2.5 pr-4">Variable</th><th class="py-2.5 pr-4">{id ? 'Wajib' : 'Required'}</th><th class="py-2.5">{id ? 'Keterangan' : 'Description'}</th></tr></thead>
      <tbody class="divide-y divide-[#1a1a1a] text-[#a1a1aa]">
        <tr><td class="py-3 pr-4 text-[#fafafa]"><code>API_KEY</code></td><td class="py-3 pr-4">{id ? 'Tidak' : 'No'}</td><td class="py-3">{id ? 'Bearer secret opsional yang diprovisikan sebelum startup. Jika tidak diberikan dan belum ada generated credential di SQLite, dashboard dapat bootstrap credential sekali.' : 'Optional Bearer secret provisioned before startup. If absent and no generated credential exists in SQLite, the dashboard can bootstrap a credential once.'}</td></tr>
        <tr><td class="py-3 pr-4 text-[#fafafa]"><code>WEBHOOK_URL</code></td><td class="py-3 pr-4">{id ? 'Berpasangan' : 'Paired'}</td><td class="py-3">{id ? 'Endpoint backend callback. Harus dipasang bersama WEBHOOK_SECRET. Hanya http/https dan embedded URL credentials ditolak.' : 'Backend callback endpoint. Must be configured together with WEBHOOK_SECRET. Only http/https are accepted and embedded URL credentials are rejected.'}</td></tr>
        <tr><td class="py-3 pr-4 text-[#fafafa]"><code>WEBHOOK_SECRET</code></td><td class="py-3 pr-4">{id ? 'Berpasangan' : 'Paired'}</td><td class="py-3">{id ? 'Signing secret HMAC-SHA256 saat webhook aktif. Minimal 32 karakter; gunakan random secret berentropi tinggi.' : 'HMAC-SHA256 signing secret when webhooks are enabled. Minimum 32 characters; use a high-entropy random secret.'}</td></tr>
        <tr><td class="py-3 pr-4 text-[#fafafa]"><code>WEBHOOK_SECRET_PREVIOUS</code></td><td class="py-3 pr-4">{id ? 'Tidak' : 'No'}</td><td class="py-3">{id ? 'Signing secret lama sementara selama rotasi. Wago menandatangani callback dengan current dan previous secret sampai value ini dihapus.' : 'Temporary previous signing secret during rotation. Wago signs callbacks with both current and previous secrets until this value is removed.'}</td></tr>
      </tbody>
    </table>
  </div>

  <h2 class="text-xl font-semibold text-[#fafafa] mb-3">Mode A — first-run dashboard</h2>
  <p class="text-sm text-[#a1a1aa] leading-relaxed mb-4">{id ? 'Ini adalah flow default stock Compose. Fresh gateway mulai tanpa API credential. Dashboard membuat kandidat random wa_..., memanggil POST /app/bootstrap, lalu backend menyimpan SHA-256 hash pada app_settings di /app/data/wago.db.' : 'This is the default stock Compose flow. A fresh gateway starts without an API credential. The dashboard creates a random wa_... candidate, calls POST /app/bootstrap, then the backend stores its SHA-256 hash in app_settings inside /app/data/wago.db.'}</p>
  <p class="text-sm text-[#71717a] mb-9">{id ? 'Raw generated key tidak disimpan server. Simpan raw key jika external application akan menggunakan Bearer authentication.' : 'The raw generated key is not stored by the server. Save it if an external application will use Bearer authentication.'}</p>

  <h2 class="text-xl font-semibold text-[#fafafa] mb-3">Mode B — pre-provisioned API key</h2>
  <CodeBlock label="container environment" code={`API_KEY=<long-random-secret>`} />
  <p class="text-sm text-[#a1a1aa] leading-relaxed mb-4">{id ? 'Gunakan mode ini bila deployment platform mengelola secret atau public route dapat dijangkau sebelum owner membuka dashboard. Runtime membaca API_KEY langsung dari environment container.' : 'Use this mode when the deployment platform manages secrets or the public route may be reachable before the owner opens the dashboard. The runtime reads API_KEY directly from the container environment.'}</p>
  <Callout title={id ? 'Stock Compose tidak meneruskan API_KEY otomatis' : 'Stock Compose does not forward API_KEY automatically'} tone="warning">
    {id ? 'docker-compose.yml bawaan tidak meneruskan API_KEY karena first-run bootstrap adalah default. Jika memilih pre-provisioned key, injeksikan API_KEY melalui platform deployment atau Compose override milik Anda.' : 'The bundled docker-compose.yml does not forward API_KEY because first-run bootstrap is the default. If you choose a pre-provisioned key, inject API_KEY through your deployment platform or your own Compose override.'}
  </Callout>

  <h2 class="text-xl font-semibold text-[#fafafa] mt-9 mb-3">Delivery webhook</h2>
  <CodeBlock label="container environment" code={`WEBHOOK_URL=https://app.example.com/api/internal/wago/webhook\nWEBHOOK_SECRET=<at-least-32-character-secret>\n# optional only during rotation\nWEBHOOK_SECRET_PREVIOUS=<old-secret>`} />
  <p class="text-sm text-[#a1a1aa] leading-relaxed mb-4">{id ? 'Saat webhook aktif, Wago mempersistenkan event message.server_accepted atau message.rejected ke SQLite sebelum network callback. Payload tidak memuat isi pesan, API key, maupun nomor/JID penerima.' : 'When webhooks are enabled, Wago persists message.server_accepted or message.rejected events to SQLite before network delivery. Payloads do not contain message text, API credentials, or recipient phone/JID data.'}</p>
  <p class="text-sm text-[#a1a1aa] leading-relaxed mb-4">{id ? 'Callback membawa Webhook-Id, Webhook-Timestamp, Webhook-Signature, X-Wago-Event, dan X-Wago-Delivery. Signature HMAC-SHA256 dihitung dari "id.timestamp.rawBody". Consumer harus verifikasi raw body dalam constant time, batasi umur timestamp (rekomendasi 5 menit), lalu deduplicate dengan Webhook-Id.' : 'Callbacks include Webhook-Id, Webhook-Timestamp, Webhook-Signature, X-Wago-Event, and X-Wago-Delivery. HMAC-SHA256 signs "id.timestamp.rawBody". Consumers should verify the raw body in constant time, enforce a timestamp age tolerance (five minutes recommended), then deduplicate by Webhook-Id.'}</p>
  <p class="text-sm text-[#a1a1aa] leading-relaxed mb-4">{id ? 'Delivery bersifat at-least-once. Timeout/network/408/429/5xx diretry secara durable dengan backoff+jitter sampai 24 jam. Restart Wago tidak membuang pending retry; stale claim akan direcover. Redirect dan 4xx biasa dianggap permanent failure dan dapat di-redeliver manual melalui API terproteksi.' : 'Delivery is at least once. Timeout/network/408/429/5xx failures are retried durably with backoff and jitter for up to 24 hours. Wago restarts do not discard pending retries; stale claims are recovered. Redirects and ordinary 4xx responses become permanent failures and can be manually redelivered through the protected API.'}</p>
  <Callout title={id ? 'server accepted bukan delivered/read' : 'server accepted is not delivered/read'} tone="warning">{id ? 'Event message.server_accepted berarti WhatsApp memberikan setidaknya server acknowledgement. Wago belum menyatakan device penerima sudah menerima atau membaca pesan.' : 'message.server_accepted means WhatsApp produced at least a server acknowledgement. Wago does not claim that the recipient device delivered or read the message.'}</Callout>

  <h2 class="text-xl font-semibold text-[#fafafa] mt-9 mb-3">{id ? 'Rotasi secret tanpa downtime' : 'Zero-downtime secret rotation'}</h2>
  <p class="text-sm text-[#a1a1aa] leading-relaxed mb-3">{id ? 'Deploy consumer agar menerima secret baru dan lama, lalu set WEBHOOK_SECRET ke secret baru dan WEBHOOK_SECRET_PREVIOUS ke secret lama. Setelah seluruh consumer menggunakan secret baru, hapus WEBHOOK_SECRET_PREVIOUS.' : 'Deploy the consumer so it accepts both new and old secrets, then set WEBHOOK_SECRET to the new secret and WEBHOOK_SECRET_PREVIOUS to the old secret. After every consumer accepts the new secret, remove WEBHOOK_SECRET_PREVIOUS.'}</p>

  <h2 class="text-xl font-semibold text-[#fafafa] mt-9 mb-3">{id ? 'Origin dan browser security' : 'Origin and browser security'}</h2>
  <p class="text-sm text-[#a1a1aa] leading-relaxed mb-4">{id ? 'Wago tidak memiliki operator setting untuk CORS allowlist. Pada production, POST /app/bootstrap memerlukan Origin HTTPS yang host-nya sama dengan Host request. State-changing request yang memakai auth cookie juga ditolak bila Origin hadir tetapi tidak same-origin.' : 'Wago does not expose an operator-configurable CORS allowlist. In production, POST /app/bootstrap requires an HTTPS Origin whose host matches the request Host. State-changing requests using cookie authentication are also rejected when an Origin is present but is not same-origin.'}</p>
  <Callout title={id ? 'External integration tetap server-to-server' : 'External integrations remain server-to-server'}>{id ? 'Bearer API key dan webhook signing secret sebaiknya disimpan di backend aplikasi Anda. Public browser bundle bukan tempat yang aman untuk secret gateway.' : 'Keep the Bearer API key and webhook signing secret in your application backend. A public browser bundle is not an appropriate place for gateway secrets.'}</Callout>

  <h2 class="text-xl font-semibold text-[#fafafa] mt-9 mb-3">{id ? 'API Explorer dan browser networking' : 'API Explorer and browser networking'}</h2>
  <p class="text-sm text-[#a1a1aa] leading-relaxed mb-4">{id ? 'Hybrid API Explorer mengirim live request langsung dari browser ke Base URL yang Anda masukkan; server dokumentasi tidak melakukan proxy. Karena Wago core tidak menambahkan cross-origin response headers, live call hanya bekerja bila browser origin rules dipenuhi oleh deployment Anda, misalnya same-origin routing atau reverse proxy yang sengaja dikonfigurasi.' : 'The Hybrid API Explorer sends live requests directly from the browser to the Base URL you enter; the documentation server does not proxy. Because Wago core does not add cross-origin response headers, live calls only work when browser origin rules are satisfied by your deployment, such as same-origin routing or an intentionally configured reverse proxy.'}</p>

  <h2 class="text-xl font-semibold text-[#fafafa] mt-9 mb-4">{id ? 'Default internal' : 'Internal defaults'}</h2>
  <p class="text-sm text-[#a1a1aa] leading-relaxed mb-4">{id ? 'Nilai berikut tidak perlu menjadi environment variable. Mereka menjaga deployment tetap kecil dan predictable.' : 'The following values do not need to become environment variables. They keep deployment small and predictable.'}</p>
  <div class="overflow-x-auto"><table class="w-full text-sm text-left"><thead><tr class="border-b border-[#262626] text-[#71717a]"><th class="py-2.5 pr-4">Setting</th><th class="py-2.5 pr-4">Default</th><th class="py-2.5">{id ? 'Keterangan' : 'Description'}</th></tr></thead><tbody class="divide-y divide-[#1a1a1a] text-[#a1a1aa]">{internalDefaults.map(row => <tr><td class="py-3 pr-4 text-[#fafafa]">{row[0]}</td><td class="py-3 pr-4 text-[#71717a]"><code>{row[1]}</code></td><td class="py-3">{row[2]}</td></tr>)}</tbody></table></div>

  <h2 class="text-xl font-semibold text-[#fafafa] mt-9 mb-3">Outbound limits</h2>
  <ul class="list-disc pl-5 text-sm text-[#a1a1aa] space-y-2 mb-4"><li>{id ? 'Account: 30 accepted send / 60 detik.' : 'Account: 30 accepted sends / 60 seconds.'}</li><li>{id ? 'Recipient: 5 accepted send / 60 detik.' : 'Recipient: 5 accepted sends / 60 seconds.'}</li><li>{id ? 'New chat: 10 recipient baru / jam.' : 'New chat: 10 new recipients / hour.'}</li><li>{id ? 'Manual webhook redelivery: 20 request / menit per source IP.' : 'Manual webhook redelivery: 20 requests/minute per source IP.'}</li></ul>
  <Callout title={id ? 'Guardrail lokal' : 'Local guardrails'} tone="warning">{id ? 'Angka tersebut adalah default defensif Wago saat ini, bukan threshold resmi WhatsApp atau jaminan anti-ban.' : 'These values are Wago defensive defaults, not official WhatsApp thresholds or an anti-ban guarantee.'}</Callout>
</DocsLayout>
