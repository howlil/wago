---
import DocsLayout from '../../layouts/DocsLayout.astro';
import PageHeader from './PageHeader.astro';
import Callout from './Callout.astro';

interface Props { lang: 'en' | 'id' }
const { lang } = Astro.props;
const id = lang === 'id';
const internalDefaults = [
  ['HTTP', '0.0.0.0:3000', id ? 'Port aplikasi tetap di dalam container.' : 'Fixed application address inside the container.'],
  ['Host publish', '127.0.0.1:3000', id ? 'Compose hanya expose ke loopback.' : 'Compose exposes only to loopback.'],
  ['Data', '/app/data', id ? 'Root persistent volume.' : 'Persistent volume root.'],
  ['WhatsApp auth', '/app/data/auth', id ? 'Baileys session storage.' : 'Baileys session storage.'],
  ['Request body', '32kb', id ? 'Batas JSON body.' : 'JSON body limit.'],
  ['Country code', '62', id ? 'Normalisasi nomor lokal Indonesia.' : 'Indonesian local-number normalization.'],
  ['Logging', 'enabled / info', id ? 'Structured request logging production.' : 'Structured production request logging.'],
  ['Web bootstrap', 'disabled in production', id ? 'Production selalu memakai API_KEY dari env.' : 'Production always uses API_KEY from the environment.'],
  ['Secure cookie', 'enabled in production', id ? 'Bukan lagi konfigurasi operator.' : 'No longer operator configuration.'],
  ['WA version strategy', 'default', id ? 'Mengikuti versi default Baileys.' : 'Uses the Baileys default version strategy.'],
];
---

<DocsLayout title={id ? 'Konfigurasi' : 'Configuration'}>
  <PageHeader
    eyebrow="Environment"
    title={id ? 'Dua konfigurasi production' : 'Two production settings'}
    description={id ? 'Wago sengaja membatasi konfigurasi operator. Production hanya membaca API_KEY dan CORS_ORIGIN dari .env; tuning lain adalah default internal.' : 'Wago intentionally keeps operator configuration small. Production reads only API_KEY and CORS_ORIGIN from .env; the rest are internal defaults.'}
  />

  <Callout title={id ? 'Hanya dua yang wajib' : 'Only two are required'} tone="warning">
    {id ? 'Startup production gagal jika API_KEY kosong atau CORS_ORIGIN kosong/menggunakan *. Tidak ada environment variable production lain yang perlu diisi.' : 'Production startup fails when API_KEY is empty or CORS_ORIGIN is empty/uses *. No other production environment variable needs to be configured.'}
  </Callout>

  <div class="overflow-x-auto mt-8 mb-10"><table class="w-full text-sm text-left"><thead><tr class="border-b border-[#262626] text-[#71717a]"><th class="py-2.5 pr-4">Variable</th><th class="py-2.5">{id ? 'Keterangan' : 'Description'}</th></tr></thead><tbody class="divide-y divide-[#1a1a1a] text-[#a1a1aa]">
    <tr><td class="py-3 pr-4 text-[#fafafa]"><code>API_KEY</code></td><td class="py-3">{id ? 'Secret Bearer untuk dashboard dan protected REST API.' : 'Bearer secret for the dashboard and protected REST API.'}</td></tr>
    <tr><td class="py-3 pr-4 text-[#fafafa]"><code>CORS_ORIGIN</code></td><td class="py-3">{id ? 'Origin HTTPS publik Wago, contoh https://wago.example.com.' : 'Public HTTPS origin for Wago, for example https://wago.example.com.'}</td></tr>
  </tbody></table></div>

  <h2 class="text-xl font-semibold text-[#fafafa] mb-4">{id ? 'Default internal' : 'Internal defaults'}</h2>
  <p class="text-sm text-[#a1a1aa] leading-relaxed mb-4">{id ? 'Nilai berikut sengaja tidak diekspos sebagai environment variable agar deployment sederhana dan konsisten.' : 'These values are intentionally not exposed as environment variables so deployments stay simple and consistent.'}</p>
  <div class="overflow-x-auto"><table class="w-full text-sm text-left"><thead><tr class="border-b border-[#262626] text-[#71717a]"><th class="py-2.5 pr-4">Setting</th><th class="py-2.5 pr-4">Default</th><th class="py-2.5">{id ? 'Keterangan' : 'Description'}</th></tr></thead><tbody class="divide-y divide-[#1a1a1a] text-[#a1a1aa]">{internalDefaults.map(row => <tr><td class="py-3 pr-4 text-[#fafafa]">{row[0]}</td><td class="py-3 pr-4 text-[#71717a]"><code>{row[1]}</code></td><td class="py-3">{row[2]}</td></tr>)}</tbody></table></div>
</DocsLayout>
