---
interface Props {
  title: string;
  tone?: 'info' | 'warning' | 'danger';
}

const { title, tone = 'info' } = Astro.props;
const classes = tone === 'danger'
  ? 'border-red-500/30 bg-red-500/5'
  : tone === 'warning'
    ? 'border-amber-500/30 bg-amber-500/5'
    : 'border-emerald-500/25 bg-emerald-500/5';
---

<div class={`border rounded-lg p-4 my-6 ${classes}`}>
  <p class="text-sm font-semibold text-[#fafafa] mb-1">{title}</p>
  <div class="text-sm text-[#a1a1aa] leading-relaxed"><slot /></div>
</div>
