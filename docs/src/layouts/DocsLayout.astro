---
import MainLayout from './MainLayout.astro';
import { getLangFromUrl, useTranslations } from '../utils/i18n';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const basePrefix = lang === 'en' ? '/en' : '/id';
const currentPath = Astro.url.pathname;

const navItems = [
  { href: `${basePrefix}/docs`, label: t.docsOverviewTitle },
  { href: `${basePrefix}/docs/api`, label: t.docsApiTitle },
  { href: `${basePrefix}/docs/deployment`, label: t.docsDeployTitle },
];

function isActive(href: string) {
  const clean = currentPath.replace(/\/$/, '');
  const target = href.replace(/\/$/, '');
  return clean === target;
}
---

<MainLayout title={`${title} — Wago`} description={description}>
  <div class="max-w-6xl mx-auto px-6 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-[220px_1fr] gap-12">

      <aside class="hidden lg:block">
        <nav class="sticky top-20 space-y-0.5">
          <p class="text-xs font-medium text-[#52525b] uppercase tracking-wider mb-3">
            {lang === 'id' ? 'Dokumentasi' : 'Documentation'}
          </p>
          {navItems.map(item => (
            <a
              href={item.href}
              class={`block px-3 py-2 rounded-md text-sm transition-colors ${
                isActive(item.href)
                  ? 'text-[#fafafa] bg-[#1a1a1a] font-medium'
                  : 'text-[#71717a] hover:text-[#a1a1aa] hover:bg-[#141414]'
              }`}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </aside>

      <article class="min-w-0">
        <slot />
      </article>

    </div>
  </div>
</MainLayout>
