---
// Default entry point
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Wago Docs</title>
    <script is:inline>
      const userLang = navigator.language || navigator.userLanguage;
      if (userLang && userLang.toLowerCase().startsWith('id')) {
        window.location.replace('/id');
      } else {
        window.location.replace('/en');
      }
    </script>
    <meta http-equiv="refresh" content="0;url=/en" />
  </head>
  <body style="background-color: #0a0a0a; color: #a1a1aa; font-family: system-ui, sans-serif; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0;">
    <p>Redirecting to Wago Docs...</p>
  </body>
</html>
