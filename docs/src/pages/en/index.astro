---
import MainLayout from '../../layouts/MainLayout.astro';
import { useTranslations } from '../../utils/i18n';

const t = useTranslations('en');
---

<MainLayout title={t.siteTitle} description={t.heroDescription}>
  <section class="pt-20 pb-16 sm:pt-28 sm:pb-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid lg:grid-cols-[1.05fr_0.95fr] gap-12 lg:gap-16 items-center">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full border border-[#234338] bg-[#0d1713] px-3 py-1.5 text-xs font-medium text-[#6ee7b7]">
            <span class="h-1.5 w-1.5 rounded-full bg-[#10b981]"></span>
            Open source · Self-hosted · Single account
          </div>
          <h1 class="mt-6 text-4xl sm:text-5xl lg:text-6xl font-bold text-[#fafafa] leading-[1.08] tracking-tight">
            A small, controlled WhatsApp gateway you run yourself
          </h1>
          <p class="mt-6 max-w-2xl text-lg text-[#a1a1aa] leading-relaxed">
            {t.heroDescription}
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a href="/en/docs/getting-started" class="px-5 py-2.5 rounded-lg text-sm font-medium text-[#0a0a0a] bg-[#fafafa] hover:bg-[#e4e4e7] transition-colors">
              Get started with Wago
            </a>
            <a href="/en/docs/api" class="px-5 py-2.5 rounded-lg text-sm font-medium text-[#d4d4d8] border border-[#333333] hover:border-[#52525b] hover:text-[#fafafa] transition-colors">
              API Reference
            </a>
            <a href="https://github.com/howlil/wago" class="px-2 py-2.5 text-sm font-medium text-[#71717a] hover:text-[#fafafa] transition-colors">
              GitHub →
            </a>
          </div>
          <div class="mt-8 flex flex-wrap gap-x-5 gap-y-2 text-xs text-[#71717a]">
            <span>Express + TypeScript</span>
            <span>React dashboard</span>
            <span>SQLite</span>
            <span>Baileys</span>
            <span>Docker / GHCR</span>
          </div>
        </div>

        <div class="relative">
          <div class="absolute -inset-8 bg-[#10b981]/5 blur-3xl rounded-full"></div>
          <div class="relative overflow-hidden rounded-2xl border border-[#262626] bg-[#0d0d0d] shadow-2xl shadow-black/30">
            <div class="flex items-center justify-between border-b border-[#202020] px-5 py-4">
              <div>
                <p class="text-sm font-semibold text-[#fafafa]">Wago Control</p>
                <p class="text-xs text-[#52525b] mt-0.5">One runtime. One account. Inspectable state.</p>
              </div>
              <span class="inline-flex items-center gap-2 rounded-full border border-[#174b37] bg-[#0d2018] px-2.5 py-1 text-xs text-[#6ee7b7]">
                <span class="h-1.5 w-1.5 rounded-full bg-[#10b981]"></span> Connected
              </span>
            </div>
            <div class="grid sm:grid-cols-3 gap-px bg-[#202020] border-b border-[#202020]">
              <div class="bg-[#0d0d0d] p-4">
                <p class="text-[11px] uppercase tracking-wider text-[#52525b]">Binding</p>
                <p class="mt-2 text-sm font-medium text-[#e4e4e7]">Bound</p>
                <p class="mt-1 text-xs text-[#71717a]">1 WhatsApp account</p>
              </div>
              <div class="bg-[#0d0d0d] p-4">
                <p class="text-[11px] uppercase tracking-wider text-[#52525b]">Account health</p>
                <p class="mt-2 text-sm font-medium text-[#e4e4e7]">Available</p>
                <p class="mt-1 text-xs text-[#71717a]">Signals inspected</p>
              </div>
              <div class="bg-[#0d0d0d] p-4">
                <p class="text-[11px] uppercase tracking-wider text-[#52525b]">Last message</p>
                <p class="mt-2 text-sm font-medium text-[#6ee7b7]">accepted</p>
                <p class="mt-1 text-xs text-[#71717a]">Retained status</p>
              </div>
            </div>
            <div class="p-5 space-y-3">
              <div class="flex items-center justify-between rounded-xl border border-[#222222] bg-[#111111] p-4">
                <div>
                  <p class="text-xs text-[#71717a]">Recipient policy</p>
                  <p class="mt-1 text-sm text-[#e4e4e7]">Example recipient</p>
                </div>
                <span class="rounded-md bg-[#0d2018] px-2.5 py-1 text-xs text-[#6ee7b7]">Allowed</span>
              </div>
              <div class="rounded-xl border border-[#222222] bg-[#111111] p-4">
                <div class="flex items-center justify-between">
                  <p class="text-xs text-[#71717a]">Audit trail</p>
                  <span class="text-[11px] text-[#52525b]">sanitized</span>
                </div>
                <div class="mt-3 space-y-2 text-xs">
                  <div class="flex gap-3"><span class="text-[#10b981]">●</span><span class="text-[#a1a1aa]">whatsapp.connection.open</span><span class="ml-auto text-[#52525b]">connection</span></div>
                  <div class="flex gap-3"><span class="text-[#60a5fa]">●</span><span class="text-[#a1a1aa]">message.accepted</span><span class="ml-auto text-[#52525b]">messaging</span></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 border-y border-[#1a1a1a] bg-[#0c0c0c]">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-2xl mb-9">
        <p class="text-xs uppercase tracking-[0.2em] text-[#10b981]">How it works</p>
        <h2 class="mt-3 text-2xl sm:text-3xl font-bold text-[#fafafa]">From container to your application in three steps</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-4">
        <div class="rounded-xl border border-[#262626] bg-[#0a0a0a] p-6">
          <span class="text-xs font-mono text-[#10b981]">01 / Deploy</span>
          <h3 class="mt-3 font-semibold text-[#fafafa]">Run one container</h3>
          <p class="mt-2 text-sm leading-relaxed text-[#71717a]">Pull the GHCR image, keep the <code>/app/data</code> volume, and put your HTTPS routing layer in front of the loopback port.</p>
        </div>
        <div class="rounded-xl border border-[#262626] bg-[#0a0a0a] p-6">
          <span class="text-xs font-mono text-[#10b981]">02 / Pair</span>
          <h3 class="mt-3 font-semibold text-[#fafafa]">Link WhatsApp</h3>
          <p class="mt-2 text-sm leading-relaxed text-[#71717a]">Bootstrap credentials when needed, open Linked devices, and scan the QR. The account binding is persisted.</p>
        </div>
        <div class="rounded-xl border border-[#262626] bg-[#0a0a0a] p-6">
          <span class="text-xs font-mono text-[#10b981]">03 / Integrate</span>
          <h3 class="mt-3 font-semibold text-[#fafafa]">Call it from your backend</h3>
          <p class="mt-2 text-sm leading-relaxed text-[#71717a]">Keep the Bearer API key on your server, allow recipients when permission exists, then send text with an idempotency key.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-2xl mb-10">
        <p class="text-xs uppercase tracking-[0.2em] text-[#10b981]">Why Wago</p>
        <h2 class="mt-3 text-3xl font-bold text-[#fafafa]">A small gateway with explicit boundaries</h2>
        <p class="mt-4 text-[#71717a] leading-relaxed">Wago does not try to become a campaign platform or multi-tenant SaaS. It focuses on one gateway that is easy to understand, operate, and audit.</p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-px bg-[#1a1a1a] border border-[#1a1a1a] rounded-2xl overflow-hidden">
        {[
          ['Single-account by design', 'One instance manages one WhatsApp binding with pairing, reconnect handling, terminal invalidation, and explicit rebind.'],
          ['Protected REST API', 'Bearer-authenticated APIs for recipients, outbound text, session state, account health, and structured audit events.'],
          ['Durable local state', 'SQLite and Baileys auth live under /app/data so important state survives normal restarts.'],
          ['Recipient controls', 'Explicit allow and opt-out state keeps recipient permission decisions inside the gateway boundary.'],
          ['Operational visibility', 'Dashboard and audit API distinguish connected, disconnected, unavailable, restriction signals, and lifecycle events.'],
          ['Docker native', 'One production image serves the API and React dashboard from one Node.js process on amd64 and arm64.'],
        ].map(([title, desc]) => (
          <div class="bg-[#0a0a0a] p-6">
            <h3 class="text-[15px] font-semibold text-[#fafafa]">{title}</h3>
            <p class="mt-2 text-sm text-[#71717a] leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 border-y border-[#1a1a1a] bg-[#0c0c0c]">
    <div class="max-w-6xl mx-auto px-6 grid lg:grid-cols-2 gap-12 items-start">
      <div>
        <p class="text-xs uppercase tracking-[0.2em] text-[#10b981]">Controlled outbound</p>
        <h2 class="mt-3 text-3xl font-bold text-[#fafafa]">Guardrails before a message reaches Baileys</h2>
        <p class="mt-4 text-[#a1a1aa] leading-relaxed">Wago evaluates recipient permission, opt-out state, idempotency, local rate windows, new-chat classification, and available account-health signals before forwarding outbound work.</p>
        <div class="mt-6 rounded-xl border border-[#3b3020] bg-[#151109] p-4 text-sm text-[#c9a96e] leading-relaxed">
          These guardrails are local defensive controls. They are not official WhatsApp safe thresholds and do not guarantee ban prevention or deliverability.
        </div>
      </div>
      <div class="space-y-3">
        {[
          ['Recipient permission', 'Explicit allow + persisted opt-out'],
          ['Retry safety', 'Idempotency key for one logical message'],
          ['Rate windows', 'Account, recipient, and new-chat local limits'],
          ['Account signals', 'Reach-out/new-chat health used defensively'],
          ['Audit evidence', 'Policy blocks and lifecycle events without raw protocol dumps'],
        ].map(([label, value]) => (
          <div class="flex gap-5 justify-between border-b border-[#222222] py-3 text-sm">
            <span class="text-[#fafafa]">{label}</span><span class="text-right text-[#71717a]">{value}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="max-w-6xl mx-auto px-6 grid lg:grid-cols-2 gap-12">
      <div>
        <p class="text-xs uppercase tracking-[0.2em] text-[#10b981]">Small by design</p>
        <h2 class="mt-3 text-3xl font-bold text-[#fafafa]">One gateway does not need a large platform</h2>
        <p class="mt-4 text-[#71717a] leading-relaxed">The runtime intentionally stays simple: one Node.js process, one SQLite database, one Baileys auth directory, and one React dashboard.</p>
      </div>
      <pre class="overflow-x-auto rounded-xl border border-[#262626] bg-[#0d0d0d] p-5 text-sm leading-7 text-[#a1a1aa]"><code>HTTP API + React dashboard
           │
           ▼
     one Node.js process
       ╱             ╲
 SQLite state    Baileys auth
 wago.db         /app/data/auth
                      │
                      ▼
                 WhatsApp Web</code></pre>
    </div>
  </section>

  <section class="py-20 border-y border-[#1a1a1a] bg-[#0c0c0c]">
    <div class="max-w-6xl mx-auto px-6 grid lg:grid-cols-2 gap-12">
      <div>
        <p class="text-xs uppercase tracking-[0.2em] text-[#10b981]">Own your runtime & data</p>
        <h2 class="mt-3 text-3xl font-bold text-[#fafafa]">Operational state stays on your infrastructure</h2>
        <p class="mt-4 text-[#71717a] leading-relaxed">Compose publishes Wago on <code>127.0.0.1:3000</code>. You choose the reverse proxy, tunnel, domain, TLS, backups, and persistent-volume lifecycle.</p>
      </div>
      <div class="rounded-xl border border-[#262626] overflow-hidden text-sm">
        <div class="flex justify-between gap-4 p-4 border-b border-[#262626]"><code class="text-[#fafafa]">/app/data/wago.db</code><span class="text-[#71717a]">settings, binding, policy, audit</span></div>
        <div class="flex justify-between gap-4 p-4 border-b border-[#262626]"><code class="text-[#fafafa]">/app/data/auth/</code><span class="text-[#71717a]">Baileys session credentials</span></div>
        <div class="flex justify-between gap-4 p-4"><code class="text-[#fafafa]">127.0.0.1:3000</code><span class="text-[#71717a]">default host publish</span></div>
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="max-w-6xl mx-auto px-6 grid lg:grid-cols-[0.85fr_1.15fr] gap-12 items-center">
      <div>
        <p class="text-xs uppercase tracking-[0.2em] text-[#10b981]">Developer first</p>
        <h2 class="mt-3 text-3xl font-bold text-[#fafafa]">Explicit server-to-server integration</h2>
        <p class="mt-4 text-[#71717a] leading-relaxed">The interactive API Explorer stays in the documentation. The landing page only shows the safe integration model: secrets belong in your application backend.</p>
        <a href="/en/docs/api" class="mt-5 inline-flex text-sm font-medium text-[#d4d4d8] hover:text-[#fafafa]">Open the API Explorer in docs →</a>
      </div>
      <pre class="overflow-x-auto rounded-xl border border-[#262626] bg-[#0d0d0d] p-5 text-sm leading-6 text-[#a1a1aa]"><code>curl -X POST "$WAGO_URL/messages/send" \
  -H "Authorization: Bearer $WAGO_API_KEY" \
  -H "Idempotency-Key: notification-123" \
  -H "Content-Type: application/json" \
  -d '{"to":"6281234567890","text":"Hello from Wago"}'</code></pre>
    </div>
  </section>

  <section class="py-16 border-t border-[#1a1a1a]">
    <div class="max-w-6xl mx-auto px-6">
      <div class="rounded-2xl border border-[#262626] bg-[#0d0d0d] p-7 sm:p-9 grid lg:grid-cols-[1fr_auto] gap-8 items-center">
        <div>
          <p class="text-xs uppercase tracking-[0.2em] text-[#71717a]">Responsible use</p>
          <h2 class="mt-3 text-2xl font-bold text-[#fafafa]">Baileys is an unofficial WhatsApp Web client</h2>
          <p class="mt-3 max-w-3xl text-sm leading-relaxed text-[#71717a]">Wago is not affiliated with WhatsApp or Meta and cannot guarantee an account will remain free from restrictions or bans. Bulk outreach, spam, anti-detection, fingerprint manipulation, and restriction bypass are outside project scope.</p>
        </div>
        <div class="flex flex-wrap lg:justify-end gap-3">
          <a href="/en/docs/getting-started" class="px-5 py-2.5 rounded-lg text-sm font-medium text-[#0a0a0a] bg-[#fafafa] hover:bg-[#e4e4e7]">Get started</a>
          <a href="/en/docs" class="px-5 py-2.5 rounded-lg text-sm font-medium text-[#d4d4d8] border border-[#333333] hover:border-[#52525b]">Documentation</a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
