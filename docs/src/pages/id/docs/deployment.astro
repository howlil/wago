---
import DocsLayout from '../../../layouts/DocsLayout.astro';
---

<DocsLayout title="Deployment">
  <h1 class="text-3xl font-bold text-[#fafafa] mb-6">Panduan Deployment</h1>
  <p class="text-[#a1a1aa] leading-relaxed mb-8">
    Repositori ini menyertakan Dockerfile multi-stage yang mengompilasi frontend React dan backend Express ke dalam satu container.
  </p>

  <h2 class="text-xl font-semibold text-[#fafafa] mb-4">Docker Compose</h2>
  <pre class="bg-[#111] border border-[#1a1a1a] rounded-lg p-4 text-sm text-[#d4d4d8] overflow-x-auto mb-8"><code>{`docker compose up --build -d
docker compose logs -f app`}</code></pre>

  <hr class="border-[#1a1a1a] my-8" />

  <h2 class="text-xl font-semibold text-[#fafafa] mb-4">Variabel Lingkungan</h2>
  <div class="overflow-x-auto mb-8">
    <table class="w-full text-sm text-left">
      <thead>
        <tr class="border-b border-[#262626] text-[#71717a]">
          <th class="py-2.5 pr-4 font-medium">Variabel</th>
          <th class="py-2.5 pr-4 font-medium">Bawaan</th>
          <th class="py-2.5 font-medium">Keterangan</th>
        </tr>
      </thead>
      <tbody class="text-[#a1a1aa]">
        <tr class="border-b border-[#1a1a1a]">
          <td class="py-2.5 pr-4 text-[#fafafa]">PORT</td>
          <td class="py-2.5 pr-4">3000</td>
          <td class="py-2.5">Port server.</td>
        </tr>
        <tr class="border-b border-[#1a1a1a]">
          <td class="py-2.5 pr-4 text-[#fafafa]">API_KEY</td>
          <td class="py-2.5 pr-4 text-[#52525b]">—</td>
          <td class="py-2.5">Kunci API statis. Atur manual atau via bootstrap.</td>
        </tr>
        <tr class="border-b border-[#1a1a1a]">
          <td class="py-2.5 pr-4 text-[#fafafa]">ALLOW_WEB_BOOTSTRAP</td>
          <td class="py-2.5 pr-4">false</td>
          <td class="py-2.5">Mengizinkan generasi kunci API via browser.</td>
        </tr>
        <tr class="border-b border-[#1a1a1a]">
          <td class="py-2.5 pr-4 text-[#fafafa]">AUTH_DIR</td>
          <td class="py-2.5 pr-4">/app/data/auth</td>
          <td class="py-2.5">Path penyimpanan kunci Baileys. Mount sebagai volume.</td>
        </tr>
        <tr>
          <td class="py-2.5 pr-4 text-[#fafafa]">CORS_ORIGIN</td>
          <td class="py-2.5 pr-4">*</td>
          <td class="py-2.5">Origin CORS yang diizinkan.</td>
        </tr>
      </tbody>
    </table>
  </div>

  <hr class="border-[#1a1a1a] my-8" />

  <h2 class="text-xl font-semibold text-[#fafafa] mb-4">Build Docker Standalone</h2>
  <pre class="bg-[#111] border border-[#1a1a1a] rounded-lg p-4 text-sm text-[#d4d4d8] overflow-x-auto"><code>{`docker build -t wa-gateway .

docker run -d \\
  --name wa-gateway \\
  -p 3000:3000 \\
  -e APP_ID=wa-gateway-prod \\
  -e API_KEY=your_key_here \\
  -v wa_data:/app/data \\
  wa-gateway`}</code></pre>
</DocsLayout>
