---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import { CodePlayground } from '../../../components/CodePlayground';
---

<DocsLayout title="Referensi API">
  <h1 class="text-3xl font-bold text-[#fafafa] mb-2">Referensi API</h1>
  <p class="text-[#a1a1aa] leading-relaxed mb-4">
    Seluruh endpoint menerima dan mengembalikan JSON. Endpoint terproteksi membutuhkan <code class="text-[#a1a1aa] bg-[#1a1a1a] px-1.5 py-0.5 rounded text-xs">Authorization: Bearer &lt;API_KEY&gt;</code>.
  </p>
  <p class="text-sm text-[#52525b] mb-8">
    Base URL: <code class="text-[#a1a1aa] bg-[#1a1a1a] px-1.5 py-0.5 rounded text-xs">http://localhost:3000</code>
  </p>

  <CodePlayground lang="id" client:load />

  <hr class="border-[#1a1a1a] my-10" />

  <h2 class="text-xl font-semibold text-[#fafafa] mb-6">Sistem</h2>

  <!-- GET /health -->
  <div class="border border-[#1a1a1a] rounded-lg mb-4 overflow-hidden">
    <div class="flex items-center gap-3 px-4 py-3 bg-[#111] border-b border-[#1a1a1a]">
      <span class="text-xs font-medium px-2 py-0.5 rounded bg-emerald-500/10 text-[#10b981]">GET</span>
      <code class="text-sm text-[#fafafa]">/health</code>
      <span class="text-xs text-[#52525b] ml-auto">Publik</span>
    </div>
    <div class="px-4 py-3">
      <p class="text-sm text-[#71717a] mb-3">Mengembalikan 200 ketika proses aktif.</p>
      <pre class="bg-[#111] border border-[#1a1a1a] rounded-lg p-4 text-sm text-[#d4d4d8] overflow-x-auto"><code>{`{ "status": "ok" }`}</code></pre>
    </div>
  </div>

  <!-- GET /ready -->
  <div class="border border-[#1a1a1a] rounded-lg mb-4 overflow-hidden">
    <div class="flex items-center gap-3 px-4 py-3 bg-[#111] border-b border-[#1a1a1a]">
      <span class="text-xs font-medium px-2 py-0.5 rounded bg-emerald-500/10 text-[#10b981]">GET</span>
      <code class="text-sm text-[#fafafa]">/ready</code>
      <span class="text-xs text-[#52525b] ml-auto">Publik</span>
    </div>
    <div class="px-4 py-3">
      <p class="text-sm text-[#71717a] mb-3">Melaporkan App ID dan status konfigurasi API key.</p>
      <pre class="bg-[#111] border border-[#1a1a1a] rounded-lg p-4 text-sm text-[#d4d4d8] overflow-x-auto"><code>{`{
  "status": "ok",
  "appId": "wa-gateway-prod",
  "apiKeyConfigured": true
}`}</code></pre>
    </div>
  </div>

  <!-- POST /app/bootstrap -->
  <div class="border border-[#1a1a1a] rounded-lg mb-4 overflow-hidden">
    <div class="flex items-center gap-3 px-4 py-3 bg-[#111] border-b border-[#1a1a1a]">
      <span class="text-xs font-medium px-2 py-0.5 rounded bg-blue-500/10 text-blue-400">POST</span>
      <code class="text-sm text-[#fafafa]">/app/bootstrap</code>
      <span class="text-xs text-[#52525b] ml-auto">Khusus Setup</span>
    </div>
    <div class="px-4 py-3">
      <p class="text-sm text-[#71717a] mb-3">Inisialisasi awal. Aktif jika <code class="text-[#a1a1aa] bg-[#1a1a1a] px-1.5 py-0.5 rounded text-xs">ALLOW_WEB_BOOTSTRAP=true</code> dan belum ada API key.</p>
      <pre class="bg-[#111] border border-[#1a1a1a] rounded-lg p-4 text-sm text-[#d4d4d8] overflow-x-auto"><code>{`{
  "success": true,
  "appId": "wa-gateway",
  "apiKey": "gw_sec_...",
  "message": "Aplikasi diinisialisasi."
}`}</code></pre>
    </div>
  </div>

  <hr class="border-[#1a1a1a] my-10" />

  <h2 class="text-xl font-semibold text-[#fafafa] mb-6">Sesi WhatsApp</h2>

  <!-- GET /whatsapp/status -->
  <div class="border border-[#1a1a1a] rounded-lg mb-4 overflow-hidden">
    <div class="flex items-center gap-3 px-4 py-3 bg-[#111] border-b border-[#1a1a1a]">
      <span class="text-xs font-medium px-2 py-0.5 rounded bg-emerald-500/10 text-[#10b981]">GET</span>
      <code class="text-sm text-[#fafafa]">/whatsapp/status</code>
      <span class="text-xs text-[#52525b] ml-auto">Terautentikasi</span>
    </div>
    <div class="px-4 py-3">
      <p class="text-sm text-[#71717a]">Mengembalikan status koneksi WhatsApp saat ini.</p>
    </div>
  </div>

  <!-- GET /whatsapp/qr/image -->
  <div class="border border-[#1a1a1a] rounded-lg mb-4 overflow-hidden">
    <div class="flex items-center gap-3 px-4 py-3 bg-[#111] border-b border-[#1a1a1a]">
      <span class="text-xs font-medium px-2 py-0.5 rounded bg-emerald-500/10 text-[#10b981]">GET</span>
      <code class="text-sm text-[#fafafa]">/whatsapp/qr/image</code>
      <span class="text-xs text-[#52525b] ml-auto">Terautentikasi</span>
    </div>
    <div class="px-4 py-3">
      <p class="text-sm text-[#71717a]">Mengembalikan QR code login sebagai <code class="text-[#a1a1aa] bg-[#1a1a1a] px-1.5 py-0.5 rounded text-xs">image/svg+xml</code>.</p>
    </div>
  </div>

  <!-- POST /whatsapp/rebind -->
  <div class="border border-[#1a1a1a] rounded-lg mb-4 overflow-hidden">
    <div class="flex items-center gap-3 px-4 py-3 bg-[#111] border-b border-[#1a1a1a]">
      <span class="text-xs font-medium px-2 py-0.5 rounded bg-amber-500/10 text-amber-400">POST</span>
      <code class="text-sm text-[#fafafa]">/whatsapp/rebind</code>
      <span class="text-xs text-[#52525b] ml-auto">Terautentikasi</span>
    </div>
    <div class="px-4 py-3">
      <p class="text-sm text-[#71717a]">Menghapus sesi otentikasi dan meminta QR baru.</p>
    </div>
  </div>

  <hr class="border-[#1a1a1a] my-10" />

  <h2 class="text-xl font-semibold text-[#fafafa] mb-6">Pesan</h2>

  <!-- POST /messages/send -->
  <div class="border border-[#262626] rounded-lg mb-4 overflow-hidden">
    <div class="flex items-center gap-3 px-4 py-3 bg-[#111] border-b border-[#1a1a1a]">
      <span class="text-xs font-medium px-2 py-0.5 rounded bg-blue-500/10 text-blue-400">POST</span>
      <code class="text-sm text-[#fafafa]">/messages/send</code>
      <span class="text-xs text-[#52525b] ml-auto">Terautentikasi</span>
    </div>
    <div class="px-4 py-3">
      <p class="text-sm text-[#71717a] mb-3">Mengirim pesan teks ke nomor telepon tujuan.</p>
      <p class="text-xs text-[#52525b] mb-2">Body permintaan</p>
      <pre class="bg-[#111] border border-[#1a1a1a] rounded-lg p-4 text-sm text-[#d4d4d8] overflow-x-auto mb-4"><code>{`{
  "to": "6281234567890",
  "text": "Halo dari Wago"
}`}</code></pre>
      <p class="text-xs text-[#52525b] mb-2">Respon</p>
      <pre class="bg-[#111] border border-[#1a1a1a] rounded-lg p-4 text-sm text-[#d4d4d8] overflow-x-auto"><code>{`{
  "success": true,
  "status": "accepted",
  "messageId": "3EB0ABC123456789"
}`}</code></pre>
    </div>
  </div>

  <hr class="border-[#1a1a1a] my-10" />

  <h2 class="text-xl font-semibold text-[#fafafa] mb-4">Kode Error</h2>
  <div class="overflow-x-auto">
    <table class="w-full text-sm text-left">
      <thead>
        <tr class="border-b border-[#262626] text-[#71717a]">
          <th class="py-2.5 pr-4 font-medium">Status</th>
          <th class="py-2.5 pr-4 font-medium">Kode</th>
          <th class="py-2.5 font-medium">Keterangan</th>
        </tr>
      </thead>
      <tbody class="text-[#a1a1aa]">
        <tr class="border-b border-[#1a1a1a]">
          <td class="py-2.5 pr-4 text-[#fafafa]">400</td>
          <td class="py-2.5 pr-4">INVALID_REQUEST</td>
          <td class="py-2.5">Parameter wajib tidak disertakan.</td>
        </tr>
        <tr class="border-b border-[#1a1a1a]">
          <td class="py-2.5 pr-4 text-[#fafafa]">401</td>
          <td class="py-2.5 pr-4">UNAUTHORIZED</td>
          <td class="py-2.5">API key salah atau tidak ada.</td>
        </tr>
        <tr class="border-b border-[#1a1a1a]">
          <td class="py-2.5 pr-4 text-[#fafafa]">409</td>
          <td class="py-2.5 pr-4">BOOTSTRAP_LOCKED</td>
          <td class="py-2.5">Aplikasi sudah diinisialisasi.</td>
        </tr>
        <tr>
          <td class="py-2.5 pr-4 text-[#fafafa]">503</td>
          <td class="py-2.5 pr-4">WHATSAPP_NOT_CONNECTED</td>
          <td class="py-2.5">WhatsApp terputus.</td>
        </tr>
      </tbody>
    </table>
  </div>
</DocsLayout>
